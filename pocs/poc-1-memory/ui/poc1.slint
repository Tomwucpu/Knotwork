// POC-1：模拟真实 Log 视图（虚拟列表 + 泳道图列）。
//
// 目的不是还原最终 UI，而是让窗口的内存布局尽可能接近真实使用场景：
// 一个可滚动的 1 万行虚拟列表，每行左侧为泳道占位图形、右侧为文本。
// 三窗口同时持有该结构，用于采集"3 窗口总 RSS"。

import { ListView } from "std-widgets.slint";

export component Poc1Window inherits Window {
    in property <string> heading: "POC-1";
    in property <string> info: "";
    in property <[string]> graph: [];
    in property <[string]> rows: [];

    title: heading;
    width: 900px;
    height: 600px;
    background: #1e1f22;

    VerticalLayout {
        padding: 8px;
        spacing: 6px;

        Text {
            text: heading;
            font-size: 16px;
            color: #e8eaed;
        }

        Text {
            text: info;
            font-size: 12px;
            color: #9aa0a6;
        }

        Rectangle {
            height: 1px;
            background: #303134;
        }

        ListView {
            for row[index] in rows: Rectangle {
                height: 24px;
                background: #1e1f22;

                HorizontalLayout {
                    spacing: 8px;

                    // 泳道列：以等宽文本模拟分支图符号，占位真实绘制成本。
                    Text {
                        text: graph[index];
                        font-family: "Consolas";
                        font-size: 13px;
                        color: #7aa2f7;
                        vertical-alignment: center;
                    }

                    Text {
                        text: row;
                        font-size: 12px;
                        color: #d0d3d6;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                }
            }
        }
    }
}
