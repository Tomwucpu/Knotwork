
import { CheckBox, ListView, Slider } from "std-widgets.slint";
import { Palette, Metrics } from "theme.slint";
import { Texts } from "texts.slint";
import {
    RefEntry, GraphCell, LogRow, ChangeRow, DiffRow, ConsoleRow, PushRow,
    RemoteRow, RecentRow, StashRow, ConflictFileRow, ConflictRow,
    RebaseStepRow, CompareRow, BlameRow, HistRow, CommitDetail,
} from "model.slint";
// 数据结构对 Rust 侧的再导出：include_modules! 据此生成类型，
// view_model.rs / session.rs / app/windows.rs 都在引用。
export {
    RefEntry, GraphCell, LogRow, ChangeRow, DiffRow, ConsoleRow, PushRow,
    RemoteRow, RecentRow, StashRow, ConflictFileRow, ConflictRow,
    RebaseStepRow, CompareRow, BlameRow, HistRow, CommitDetail,
}
import {
    FlatButton, TabButton, Field, OptionToggle, Divider, VDivider, SectionLabel,
    IdeaButton, IdeaIconButton, ToolbarSeparator, FilterButton, IdeaSearchField, IdeaCheckbox,
    ToolWindowHeader,
} from "widgets.slint";
import { IdeaIcon } from "icons.slint";
import {
    LogRowView, DiffRowView, ChangeRowView, ChangeGroupRowView, ConsoleRowView, BlameRowView,
    CommitFileRowView,
} from "rows.slint";
import {
    ConfirmDialog, SettingsDialog, PushDialog, RemotesDialog, CommitCtxMenu, RecentCtxMenu,
    OpDialog, IplanDialog, CflDialog, CompareDialog, FileHistoryDialog,
} from "dialogs.slint";

export component MainWindow inherits Window {
    // ---- 仓库与状态 ----
    in-out property <string> repo-title: "Knotwork";
    in-out property <string> repo-path: "";
    in-out property <string> branch-text: "—";
    in-out property <string> head-text: "—";
    in-out property <string> git-text: "";
    in-out property <string> state-text: "";
    in-out property <bool> state-banner-visible: false;

    // ---- 主题（FR-SET-02 外观组）----
    in-out property <bool> dark-theme: true;

    // ---- 界面语言（NFR-L10N-01）：英文为真时 Texts 全量切换 ----
    in-out property <bool> english-ui: false;
    // 设置对话框里的语言选择（保存并应用后写入 english-ui）。
    in-out property <bool> set-language-en: false;

    // ---- 只读模式（FR-MR-04）----
    in-out property <bool> read-only: false;
    in-out property <string> read-only-reason: "";

    // ---- 侧栏 ----
    in-out property <[RefEntry]> sidebar-refs: [];
    in-out property <string> branch-input: "";
    in-out property <int> selected-ref: -1;

    // ---- 空状态（未打开仓库）----
    in-out property <bool> has-repo: false;
    in-out property <string> open-path: "";
    in-out property <string> empty-message: Texts.s0;
    in-out property <[RecentRow]> recent: [];
    // 最近项目搜索词（空串表示不过滤）与行内「⋮」菜单状态。
    in-out property <string> project-search: "";
    in-out property <bool> recent-menu-visible: false;
    in-out property <length> recent-menu-x: 0px;
    in-out property <length> recent-menu-y: 0px;
    in-out property <string> recent-menu-path: "";

    // ---- 日志面板 ----
    in-out property <[LogRow]> log-rows: [];
    in-out property <string> log-summary: "";
    in-out property <int> log-total: 0;
    in-out property <bool> log-loading: false;
    in-out property <string> search-query: "";
    in-out property <bool> search-regex: false;
    in-out property <bool> search-active: false;
    in-out property <bool> opt-topo: false;
    in-out property <bool> opt-first-parent: false;
    in-out property <bool> opt-hide-merges: false;
    in-out property <bool> opt-collapse: false;
    // 日志详情：选中提交的元数据与文件清单。
    in-out property <CommitDetail> commit-detail: {
        visible: false,
        subject: "",
        author: "",
        email: "",
        when: "",
        hash: "",
        parents: "",
        files: [],
        selected-file: -1,
    };

    // ---- Diff 面板 ----
    in-out property <[DiffRow]> diff-rows: [];
    in-out property <string> diff-title: Texts.s1;
    in-out property <string> diff-stats: "";
    in-out property <bool> diff-loading: false;
    in-out property <string> diff-hint: "";
    // 当前差异是否来自"已暂存"一侧（决定按钮语义）。
    in-out property <bool> diff-staged-view: false;
    // 当前差异是否支持按块落库（新增/未跟踪文件只能整文件暂存）。
    in-out property <bool> diff-selectable: false;

    // ---- 本地更改 ----
    in-out property <[ChangeRow]> change-rows: [];
    in-out property <string> change-summary: "";
    in-out property <bool> selection-is-untracked: false;
    in-out property <bool> staged-collapsed: false;
    in-out property <bool> unstaged-collapsed: false;
    // 提交工具窗收起状态（纯界面状态，不落配置）。
    in-out property <bool> commit-collapsed: false;

    // ---- 提交（FR-CMT-01/02）----
    in-out property <string> commit-message: "";
    in-out property <bool> commit-amend: false;
    in-out property <bool> commit-reset-author: false;
    in-out property <string> commit-hint: "";
    in-out property <bool> commit-enabled: true;
    in-out property <bool> staging-mode: true;

    // ---- Console ----
    in-out property <[ConsoleRow]> console-rows: [];
    in-out property <string> console-summary: "";

    // ---- 远端（FR-RMT）----
    // 网络操作进行中：显示进度条与取消按钮。
    in-out property <bool> network-busy: false;
    in-out property <string> network-label: "";
    in-out property <string> network-progress: "";
    // 最近一次远端失败（结论 + 建议，多行）。
    in-out property <bool> network-error-visible: false;
    in-out property <string> network-error: "";
    // 当前仓库的远端名（工具栏显示与推送目标）。
    in-out property <[string]> remote-names: [];
    in-out property <string> remote-current: "";
    // 更新策略：0 = 合并，1 = 变基，2 = 仅快进
    in-out property <int> pull-strategy: 0;

    // ---- 远端管理遮罩 ----
    in-out property <bool> remotes-visible: false;
    in-out property <[RemoteRow]> remote-rows: [];
    in-out property <int> remote-selected: -1;
    in-out property <string> remote-name-input: "";
    in-out property <string> remote-url-input: "";
    in-out property <string> remote-help: "";
    in-out property <string> token-host: "";
    in-out property <string> token-input: "";
    in-out property <bool> keyring-available: true;

    // ---- 推送预览遮罩（FR-RMT-03）----
    in-out property <bool> push-visible: false;
    in-out property <[PushRow]> push-rows: [];
    in-out property <string> push-summary: "";
    in-out property <string> push-hint: "";
    in-out property <bool> push-force: false;
    in-out property <bool> push-set-upstream: false;
    in-out property <bool> push-creates-branch: false;
    in-out property <bool> push-protected: false;

    // ---- 底部面板标签：0 = Git 日志，1 = Console，2 = Stash ----
    in-out property <int> bottom-tab: 0;

    // ---- 能力提示（FR-STA-04）----
    in-out property <bool> cli-missing: false;
    in-out property <string> cli-missing-reason: "";

    // ---- 提示条 ----
    in-out property <string> toast: "";

    // ---- 二次确认遮罩（FR-LC-02 / D4）----
    in-out property <bool> confirm-visible: false;
    in-out property <string> confirm-title: Texts.s2;
    in-out property <string> confirm-detail: "";
    in-out property <bool> confirm-danger: true;

    // ---- 设置遮罩（FR-SET-01/02）----
    in-out property <bool> settings-visible: false;
    in-out property <bool> set-warn-detached: true;
    in-out property <bool> set-warn-crlf: true;
    in-out property <int> set-update-strategy: 0;
    in-out property <int> set-cache-mib: 32;
    in-out property <string> set-protected: "";
    in-out property <string> set-diff-tool: "";
    in-out property <string> set-merge-tool: "";
    in-out property <int> set-log-level: 2;
    in-out property <string> set-status: "";

    // ---- M4：提交上下文菜单（FR-LOG-07/08）----
    in-out property <bool> ctx-visible: false;
    in-out property <length> ctx-x: 0px;
    in-out property <length> ctx-y: 0px;
    in-out property <string> ctx-subject: "";
    in-out property <bool> ctx-is-head: false;

    // ---- M4：通用操作对话框（合并/变基/重置/补丁/标签）----
    // 用一个对话框承载五种"填一个参数再确认"的操作：它们的交互形态完全一致，
    // 分成五个遮罩只会让 Slint 与接线各多五份一模一样的代码。
    in-out property <bool> op-visible: false;
    in-out property <int> op-kind: 0;
    in-out property <string> op-title: "";
    in-out property <string> op-hint: "";
    in-out property <string> op-input: "";
    in-out property <string> op-placeholder: "";
    in-out property <string> op-input2: "";
    in-out property <string> op-placeholder2: "";
    in-out property <bool> op-show-input2: false;
    in-out property <[string]> op-modes: [];
    in-out property <int> op-mode: 0;
    in-out property <bool> op-danger: false;

    // ---- M4：交互式变基编辑器（FR-MRG-03）----
    in-out property <bool> iplan-visible: false;
    in-out property <[RebaseStepRow]> iplan-rows: [];
    in-out property <string> iplan-title: "";
    in-out property <string> iplan-summary: "";
    in-out property <int> iplan-selected: -1;
    in-out property <string> iplan-message: "";
    in-out property <bool> iplan-message-visible: false;

    // ---- M4：三路冲突编辑器（FR-CFL）----
    in-out property <bool> cfl-visible: false;
    in-out property <[ConflictFileRow]> cfl-files: [];
    in-out property <[ConflictRow]> cfl-rows: [];
    in-out property <string> cfl-title: "";
    in-out property <string> cfl-summary: "";
    in-out property <string> cfl-manual: "";
    in-out property <bool> cfl-manual-visible: false;
    in-out property <int> cfl-block: -1;

    // ---- M4：贮藏面板（FR-STH）----
    in-out property <[StashRow]> stash-rows: [];
    in-out property <string> stash-message: "";
    in-out property <bool> stash-untracked: false;
    in-out property <string> stash-summary: "";

    // ---- M4：比较 / 快照浏览（FR-LOG-08）----
    in-out property <bool> compare-visible: false;
    in-out property <[CompareRow]> compare-rows: [];
    in-out property <string> compare-title: "";
    in-out property <bool> compare-browse: false;

    // ---- M4：忙碌与中断恢复 ----
    in-out property <string> advanced-label: "";
    in-out property <bool> resume-visible: false;
    in-out property <bool> resume-can-skip: false;

    in-out property <bool> blame-visible: false;
    in-out property <[BlameRow]> blame-rows: [];
    in-out property <string> blame-title: "";
    in-out property <string> blame-spec-label: "";
    in-out property <int> blame-selected: -1;
    in-out property <int> blame-anchor: -1;
    // blame 链式导航的滚动目标；与 ListView.content-y 双向绑定。
    in-out property <length> blame-scroll-y: 0px;
    in-out property <bool> blame-can-chain: false;
    in-out property <string> blame-truncated: "";

    in-out property <bool> diff-image-visible: false;
    in property <image> diff-img-old;
    in property <image> diff-img-new;
    in-out property <bool> diff-img-old-present: false;
    in-out property <bool> diff-img-new-present: false;
    in-out property <string> diff-img-meta-old: "";
    in-out property <string> diff-img-meta-new: "";
    in-out property <bool> diff-img-equal: false;
    in-out property <int> img-mode: 0;
    in-out property <float> img-blend: 0.5;

    in-out property <bool> history-visible: false;
    in-out property <[HistRow]> history-rows: [];
    in-out property <string> history-title: "";
    in-out property <bool> history-truncated: false;
    in-out property <int> history-filter: 0;

    callback poll();
    callback refresh();
    callback open-repo(string);
    callback browse-repo();
    callback select-log(int);
    callback select-change(int);
    callback select-commit-file(int);
    callback select-ref(int);
    callback toggle-ref-group(int);
    callback export-console();
    callback clear-console();
    callback use-recent(string);
    callback filter-recent(string);
    callback remove-recent(string);

    // 写操作
    callback stage-selected();
    callback unstage-selected();
    callback stage-all();
    callback unstage-all();
    callback toggle-change-group(int);
    callback discard-selected();
    callback delete-selected();
    callback ignore-selected(int);
    callback commit();
    callback commit-and-push();
    callback set-commit-message(string);
    callback toggle-amend(bool);
    callback toggle-reset-author(bool);
    callback toggle-diff-row(int);
    callback stage-hunks();
    callback unstage-hunks();
    callback discard-hunks();
    callback set-branch-input(string);
    callback branch-create(bool);
    callback branch-checkout();
    callback branch-rename();
    callback branch-delete(bool);
    callback branch-upstream();
    callback checkout-selected-commit();
    callback delete-tag();

    // 搜索与图选项
    callback set-search(string);
    callback toggle-search-regex(bool);
    callback run-search();
    callback clear-search();
    callback toggle-option(int);

    // 远端（FR-RMT）
    callback fetch-selected();
    callback fetch-all();
    callback update-project();
    callback push-request();
    callback push-confirm();
    callback push-cancel();
    callback toggle-push-force(bool);
    callback toggle-push-upstream(bool);
    callback set-pull-strategy(int);
    callback select-remote(int);
    callback cancel-network();
    callback dismiss-network-error();
    callback open-remotes();
    callback close-remotes();
    callback set-remote-name(string);
    callback set-remote-url(string);
    callback remote-add();
    callback remote-remove();
    callback remote-set-url();
    callback set-token-input(string);
    callback save-token();
    callback forget-token();

    // 遮罩
    callback confirm-yes();
    callback confirm-no();
    callback open-settings();
    callback close-settings();
    callback apply-settings();
    callback toggle-theme(bool);

    // ---- M4：提交上下文菜单 ----
    callback open-commit-menu(int, length, length);
    callback close-commit-menu();
    // 菜单项统一走一个回调：动作标识由 Rust 侧解释，避免十三个几乎相同的回调。
    callback commit-action(string);

    // ---- M4：通用操作对话框 ----
    callback set-op-input(string);
    callback set-op-input2(string);
    callback set-op-mode(int);
    callback op-confirm();
    callback op-cancel();

    // ---- M4：交互式变基 ----
    callback iplan-select(int);
    callback iplan-action(int, int);
    callback iplan-set-message(string);
    callback iplan-confirm();
    callback iplan-cancel();

    // ---- M4：三路冲突解决 ----
    callback cfl-select(int);
    callback cfl-pick-block(int);
    callback cfl-take-side(int);
    callback cfl-resolve(int, int);
    callback cfl-resolve-all(int);
    callback cfl-set-manual(string);
    callback cfl-apply-manual();
    callback cfl-mark-resolved();
    callback cfl-close();

    // ---- M4：贮藏 ----
    callback request-stash-list();
    callback set-stash-message(string);
    callback toggle-stash-untracked(bool);
    callback stash-create();
    callback stash-apply(int);
    callback stash-pop(int);
    callback stash-drop(int);
    callback stash-branch(int);

    // ---- M4：比较 / 快照浏览 ----
    callback compare-select(int);
    callback compare-close();

    // ---- M4：中断恢复（merge / rebase / cherry-pick / revert）----
    callback resume-continue();
    callback resume-skip();
    callback resume-abort();

    callback request-blame-selected();
    callback request-file-history-selected();
    callback blame-select(int);
    callback blame-close();
    callback blame-chain();
    callback blame-open-history();
    callback history-select(int);
    callback history-set-filter(int);
    callback history-close();

    title: repo-title + (read-only ? Texts.s3 : "");
    // 初始尺寸用 preferred-* 而不是 width/height：后者会被 Slint 同时当作 min/max，
    // 令窗口变成固定尺寸（winit 据此 set_resizable(false)，既不能拖边拉伸也没有
    // 最大化按钮）。这里显式给出 min/max，避免 min/max 从内容推导（部分视图会推导出
    // min==max 而再次卡死尺寸）；preferred-* 只决定首屏尺寸。
    preferred-width: 1000px;
    preferred-height: 650px;
    min-width: 900px;
    min-height: 600px;
    max-width: 100000px;
    max-height: 100000px;
    background: Palette.bg;

    init => {
        Palette.dark = root.dark-theme;
        Texts.en = root.english-ui;
    }
    changed dark-theme => { Palette.dark = root.dark-theme; }
    changed english-ui => { Texts.en = root.english-ui; }

    // 布局断环：若在子元素 binding 里直接读 root.width/height，Slint 会判定为
    // binding loop（窗口 layoutinfo <-> 子尺寸，因为 width 由 layoutinfo 推导）。
    // 这里把窗口尺寸经 changed 拷进普通属性，布局只读这些普通属性即可断环。
    property <length> viewport-width: 1000px;
    property <length> viewport-height: 650px;
    changed width => { root.viewport-width = root.width; }
    changed height => { root.viewport-height = root.height; }

    changed blame-anchor => {
        if root.blame-anchor >= 0 {
            root.blame-scroll-y = min(0px, -(root.blame-anchor * Metrics.blame-row-height));
            root.blame-anchor = -1;
        }
    }

    // 每 100ms 向 Rust 侧要一次异步结果（UI 线程只做搬运，不做 I/O）。
    Timer {
        interval: 100ms;
        running: true;
        triggered => { root.poll(); }
    }

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // ---------------------------------------------------- 状态横幅
        Rectangle {
            height: root.state-banner-visible ? 28px : 0px;
            background: Palette.warn-bg;
            visible: root.state-banner-visible;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 8px;
                spacing: 8px;

                Text {
                    text: root.state-text;
                    color: Palette.warn-text;
                    font-size: Palette.font-sm;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Rectangle { horizontal-stretch: 1; }

                FlatButton {
                    text: Texts.s8;
                    visible: root.resume-visible;
                    clicked => { root.resume-continue(); }
                }

                FlatButton {
                    text: Texts.s9;
                    visible: root.resume-visible && root.resume-can-skip;
                    clicked => { root.resume-skip(); }
                }

                FlatButton {
                    text: Texts.s10;
                    visible: root.resume-visible;
                    danger: true;
                    clicked => { root.resume-abort(); }
                }

                FlatButton {
                    text: Texts.s11;
                    clicked => { root.bottom-tab = 1; }
                }
            }
        }

        Rectangle {
            height: root.read-only ? 28px : 0px;
            background: Palette.danger-bg;
            visible: root.read-only;

            Text {
                x: 12px;
                text: root.read-only-reason;
                color: Palette.danger-text;
                font-size: Palette.font-sm;
                vertical-alignment: center;
            }
        }

        Rectangle {
            height: root.cli-missing ? 44px : 0px;
            background: Palette.danger-bg;
            visible: root.cli-missing;

            Text {
                x: 12px;
                y: 6px;
                width: parent.width - 24px;
                text: root.cli-missing-reason;
                color: Palette.danger-text;
                font-size: Palette.font-sm;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }

        Rectangle {
            height: root.network-busy ? 28px : 0px;
            visible: root.network-busy;
            background: Palette.panel;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 8px;
                spacing: 8px;

                Text {
                    text: root.network-label + "…";
                    color: Palette.text;
                    font-size: Palette.font-sm;
                    vertical-alignment: center;
                }

                Text {
                    horizontal-stretch: 1;
                    text: root.network-progress;
                    color: Palette.text-faint;
                    font-size: Palette.font-meta;
                    font-family: Palette.mono-font;
                    vertical-alignment: center;
                    overflow: elide;
                }

                FlatButton {
                    text: Texts.s12;
                    danger: true;
                    clicked => { root.cancel-network(); }
                }
            }
        }

        Rectangle {
            height: root.network-error-visible ? 62px : 0px;
            visible: root.network-error-visible;
            background: Palette.danger-bg;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 8px;
                spacing: 8px;

                Text {
                    horizontal-stretch: 1;
                    text: root.network-error;
                    color: Palette.danger-text;
                    font-size: Palette.font-sm;
                    wrap: word-wrap;
                    overflow: elide;
                }

                FlatButton {
                    text: Texts.s13;
                    clicked => { root.dismiss-network-error(); }
                }
            }
        }

        // ---------------------------------------------------- 仓库主体
        if root.has-repo: VerticalLayout {
            vertical-stretch: 1;
            padding: 0px;
            spacing: 0px;

            // 上半：提交工具窗 + 差异编辑器
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 0px;

                // ---- 提交折叠后的窄条
                Rectangle {
                    width: root.commit-collapsed ? 30px : 0px;
                    visible: root.commit-collapsed;
                    background: Palette.panel;

                    IdeaIconButton {
                        icon: "changes";
                        x: (parent.width - self.width) / 2;
                        y: 6px;
                        clicked => { root.commit-collapsed = false; }
                    }
                }

                // ---- 提交工具窗
                Rectangle {
                    width: root.commit-collapsed
                        ? 0px
                        : (root.viewport-width < 1100px ? 320px : Metrics.commit-panel-width);
                    visible: !root.commit-collapsed;
                    background: Palette.panel;
                    clip: true;

                    VerticalLayout {
                        height: parent.height;
                        spacing: 0px;

                        ToolWindowHeader {
                            title: Texts.s61;
                            show-more: false;
                            toggle-minimize => { root.commit-collapsed = true; }
                        }

                        // 工具栏：刷新 / 批量暂存 / 批量反暂存 / 丢弃 / 设置
                        Rectangle {
                            height: Metrics.toolbar-height;
                            background: Palette.panel;

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                spacing: 2px;

                                IdeaIconButton {
                                    icon: "refresh";
                                    clicked => { root.refresh(); }
                                }

                                ToolbarSeparator { }

                                IdeaIconButton {
                                    icon: "add";
                                    enabled: !root.read-only;
                                    clicked => { root.stage-all(); }
                                }

                                IdeaIconButton {
                                    icon: "remove";
                                    enabled: !root.read-only;
                                    clicked => { root.unstage-all(); }
                                }

                                ToolbarSeparator { }

                                IdeaIconButton {
                                    icon: "revert";
                                    enabled: !root.read-only;
                                    tint: root.read-only ? Palette.text-faint : Palette.red;
                                    clicked => { root.discard-selected(); }
                                }

                                Rectangle { horizontal-stretch: 1; }

                                IdeaIconButton {
                                    icon: "settings";
                                    clicked => { root.open-settings(); }
                                }
                            }
                        }

                        Divider { }

                        // 已暂存 / 未暂存 + 文件行
                        ListView {
                            height: max(
                                50px,
                                root.viewport-height - 573px
                                    - (root.state-banner-visible ? 28px : 0px)
                                    - (root.read-only ? 28px : 0px)
                                    - (root.cli-missing ? 44px : 0px)
                                    - (root.network-busy ? 28px : 0px)
                                    - (root.network-error-visible ? 62px : 0px));
                            for row[index] in root.change-rows: Rectangle {
                                height: row.kind == 1 ? 28px : Metrics.list-row-height;
                                width: 100%;

                                if row.kind == 1: ChangeGroupRowView {
                                    width: 100%;
                                    height: 100%;
                                    title: row.group == 0 ? Texts.s162 : Texts.s163;
                                    group: row.group;
                                    count: row.count;
                                    collapsed: row.collapsed;
                                    toggled => { root.toggle-change-group(row.group); }
                                    action => {
                                        if row.group == 0 {
                                            root.unstage-all();
                                        } else {
                                            root.stage-all();
                                        }
                                    }
                                }

                                if row.kind == 0: ChangeRowView {
                                    width: 100%;
                                    height: 100%;
                                    row-index: row.row-index;
                                    group: row.group;
                                    path: row.path;
                                    code: row.code;
                                    bucket: row.bucket;
                                    note: row.note;
                                    is-selected: row.is-selected;
                                    is-conflict: row.is-conflict;
                                    is-untracked: row.is-untracked;
                                    clicked => { root.select-change(row.row-index); }
                                }
                            }
                        }

                        // 提交消息区
                        Rectangle {
                            height: 110px;
                            background: Palette.panel;

                            VerticalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 6px;
                                padding-bottom: 6px;
                                spacing: 4px;

                                Rectangle {
                                    vertical-stretch: 1;
                                    background: Palette.field-bg;
                                    border-radius: Palette.radius;
                                    border-width: 1px;
                                    border-color: commit-input.has-focus ? Palette.accent-strong : Palette.field-border;

                                    commit-input := TextInput {
                                        x: 8px;
                                        y: 6px;
                                        width: parent.width - 16px;
                                        height: parent.height - 12px;
                                        text <=> root.commit-message;
                                        single-line: false;
                                        wrap: word-wrap;
                                        color: Palette.text;
                                        font-size: Palette.font-md;
                                    }

                                    Text {
                                        x: 8px;
                                        y: 7px;
                                        width: parent.width - 16px;
                                        text: Texts.s57;
                                        color: Palette.text-faint;
                                        font-size: Palette.font-md;
                                        visible: root.commit-message == "";
                                    }
                                }
                            }
                        }

                        // 修订 / 保留作者 / 提交提示
                        Rectangle {
                            height: 30px;
                            background: Palette.panel;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 8px;
                                spacing: 10px;

                                IdeaCheckbox {
                                    text: Texts.s183;
                                    checked: root.commit-amend;
                                    toggled => { root.toggle-amend(!root.commit-amend); }
                                }

                                IdeaCheckbox {
                                    text: Texts.s184;
                                    checked: root.commit-reset-author;
                                    enabled: root.commit-amend;
                                    toggled => { root.toggle-reset-author(!root.commit-reset-author); }
                                }

                                Rectangle { horizontal-stretch: 1; }

                                Text {
                                    text: root.commit-hint;
                                    color: Palette.text-faint;
                                    font-size: Palette.font-meta;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }

                        // 提交动作区
                        Rectangle {
                            height: 46px;
                            background: Palette.panel;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 8px;
                                spacing: 6px;

                                IdeaButton {
                                    horizontal-stretch: 1;
                                    text: root.commit-amend ? Texts.s60 : Texts.s61;
                                    variant: "primary";
                                    enabled: !root.read-only && root.commit-enabled && !root.cli-missing;
                                    clicked => { root.commit(); }
                                }

                                IdeaButton {
                                    width: 150px;
                                    text: Texts.s165;
                                    variant: "outline";
                                    enabled: !root.read-only && root.commit-enabled && !root.cli-missing;
                                    clicked => { root.commit-and-push(); }
                                }

                                IdeaIconButton {
                                    icon: "settings";
                                    clicked => { root.open-settings(); }
                                }
                            }
                        }
                    }
                }

                VDivider { }

                // ---- 差异编辑器
                Rectangle {
                    horizontal-stretch: 1;
                    background: Palette.bg;
                    clip: true;

                    Rectangle {
                        visible: !root.blame-visible;

                        VerticalLayout {
                            height: parent.height;
                            spacing: 0px;

                            Rectangle {
                                height: Metrics.toolbar-height;
                                background: Palette.bar;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 8px;
                                    spacing: 6px;

                                    Text {
                                        width: 240px;
                                        text: root.diff-title;
                                        color: Palette.text;
                                        font-size: Palette.font-md;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: root.diff-stats;
                                        color: Palette.text-faint;
                                        font-size: Palette.font-meta;
                                        vertical-alignment: center;
                                    }

                                    Rectangle { horizontal-stretch: 1; }

                                    Text {
                                        text: root.diff-hint;
                                        color: Palette.text-faint;
                                        font-size: Palette.font-meta;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }

                                    FlatButton {
                                        text: Texts.s35;
                                        enabled: !root.read-only && root.diff-selectable
                                            && !root.diff-staged-view && root.staging-mode;
                                        clicked => { root.stage-hunks(); }
                                    }

                                    FlatButton {
                                        text: Texts.s36;
                                        enabled: !root.read-only && root.diff-selectable && root.diff-staged-view;
                                        clicked => { root.unstage-hunks(); }
                                    }

                                    FlatButton {
                                        text: Texts.s37;
                                        enabled: !root.read-only && root.diff-selectable && !root.diff-staged-view;
                                        danger: true;
                                        clicked => { root.discard-hunks(); }
                                    }
                                }
                            }

                            Divider { }

                            Rectangle {
                                vertical-stretch: 1;

                                ListView {
                                    width: 100%;
                                    height: 100%;
                                    visible: !root.diff-image-visible;
                                    for row[index] in root.diff-rows: DiffRowView {
                                        height: Metrics.diff-row-height;
                                        kind: row.kind;
                                        old-no: row.old-no;
                                        new-no: row.new-no;
                                        segments: row.segments;
                                        changed: row.changed;
                                        is-hunk-header: row.is-hunk-header;
                                        selectable: row.selectable;
                                        selected: row.selected;
                                        clicked => { root.toggle-diff-row(index); }
                                    }
                                }

                                // 空状态：没有选中文件 / 提交时给出明确提示。
                                Text {
                                    width: 100%;
                                    height: 100%;
                                    text: Texts.s185;
                                    color: Palette.text-faint;
                                    font-size: Palette.font-md;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    visible: root.diff-rows.length == 0 && !root.diff-loading && !root.diff-image-visible;
                                }

                                Rectangle {
                                    width: 100%;
                                    height: 100%;
                                    visible: root.diff-image-visible;

                                    VerticalLayout {
                                        spacing: 0px;

                                        Rectangle {
                                            height: 28px;
                                            background: Palette.panel;

                                            HorizontalLayout {
                                                padding-left: 6px;
                                                spacing: 6px;

                                                OptionToggle {
                                                    text: Texts.s38;
                                                    checked: root.img-mode == 0;
                                                    toggled => { root.img-mode = 0; }
                                                }
                                                OptionToggle {
                                                    text: Texts.s39;
                                                    checked: root.img-mode == 1;
                                                    toggled => { root.img-mode = 1; }
                                                }

                                                Text {
                                                    text: root.diff-img-equal ? Texts.s40 : "";
                                                    color: Palette.green;
                                                    font-size: Palette.font-meta;
                                                    vertical-alignment: center;
                                                }

                                                Rectangle { horizontal-stretch: 1; }

                                                Slider {
                                                    width: 160px;
                                                    visible: root.img-mode == 1;
                                                    minimum: 0;
                                                    maximum: 1;
                                                    value <=> root.img-blend;
                                                }
                                            }
                                        }

                                        Rectangle {
                                            vertical-stretch: 1;

                                            if root.img-mode == 0: HorizontalLayout {
                                                spacing: 1px;

                                                VerticalLayout {
                                                    horizontal-stretch: 1;
                                                    spacing: 2px;

                                                    Rectangle {
                                                        vertical-stretch: 1;
                                                        clip: true;
                                                        background: Palette.bg;
                                                        Image {
                                                            width: 100%;
                                                            height: 100%;
                                                            source: root.diff-img-old;
                                                            image-fit: contain;
                                                        }
                                                        Text {
                                                            width: 100%;
                                                            vertical-alignment: center;
                                                            horizontal-alignment: center;
                                                            visible: !root.diff-img-old-present;
                                                            text: root.diff-img-meta-old;
                                                            color: Palette.text-faint;
                                                            font-size: Palette.font-sm;
                                                        }
                                                    }

                                                    Text {
                                                        height: 18px;
                                                        text: root.diff-img-meta-old;
                                                        color: Palette.text-faint;
                                                        font-size: Palette.font-meta;
                                                        vertical-alignment: center;
                                                    }
                                                }

                                                VerticalLayout {
                                                    horizontal-stretch: 1;
                                                    spacing: 2px;

                                                    Rectangle {
                                                        vertical-stretch: 1;
                                                        clip: true;
                                                        background: Palette.bg;
                                                        Image {
                                                            width: 100%;
                                                            height: 100%;
                                                            source: root.diff-img-new;
                                                            image-fit: contain;
                                                        }
                                                        Text {
                                                            width: 100%;
                                                            vertical-alignment: center;
                                                            horizontal-alignment: center;
                                                            visible: !root.diff-img-new-present;
                                                            text: root.diff-img-meta-new;
                                                            color: Palette.text-faint;
                                                            font-size: Palette.font-sm;
                                                        }
                                                    }

                                                    Text {
                                                        height: 18px;
                                                        text: root.diff-img-meta-new;
                                                        color: Palette.text-faint;
                                                        font-size: Palette.font-meta;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }

                                            if root.img-mode == 1: Rectangle {
                                                background: Palette.bg;
                                                clip: true;

                                                Image {
                                                    width: 100%;
                                                    height: 100%;
                                                    source: root.diff-img-old;
                                                    image-fit: contain;
                                                    visible: root.diff-img-old-present;
                                                }

                                                Image {
                                                    width: 100%;
                                                    height: 100%;
                                                    source: root.diff-img-new;
                                                    image-fit: contain;
                                                    visible: root.diff-img-new-present;
                                                    opacity: root.img-blend;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Blame 视图沿用原有工具栏与虚拟列表，仅换 token。
                    Rectangle {
                        visible: root.blame-visible;

                        VerticalLayout {
                            spacing: 0px;

                            Rectangle {
                                height: Metrics.toolbar-height;
                                background: Palette.bar;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 8px;
                                    spacing: 6px;

                                    FlatButton {
                                        text: Texts.s41;
                                        clicked => { root.blame-close(); }
                                    }

                                    FlatButton {
                                        text: Texts.s42;
                                        clicked => { root.blame-open-history(); }
                                    }

                                    Text {
                                        width: 220px;
                                        text: root.blame-title;
                                        color: Palette.text;
                                        font-size: Palette.font-md;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: root.blame-spec-label;
                                        color: Palette.amber;
                                        font-size: Palette.font-meta;
                                        vertical-alignment: center;
                                    }

                                    Rectangle { horizontal-stretch: 1; }

                                    Text {
                                        text: root.blame-truncated;
                                        color: Palette.amber;
                                        font-size: Palette.font-meta;
                                        vertical-alignment: center;
                                    }

                                    FlatButton {
                                        text: Texts.s43;
                                        enabled: root.blame-can-chain && !root.read-only;
                                        clicked => { root.blame-chain(); }
                                    }
                                }
                            }

                            Divider { }

                            blame-list := ListView {
                                vertical-stretch: 1;
                                content-y <=> root.blame-scroll-y;
                                for row[index] in root.blame-rows: BlameRowView {
                                    height: Metrics.blame-row-height;
                                    line-no: row.line-no;
                                    commit: row.commit;
                                    author: row.author;
                                    when: row.when;
                                    summary: row.summary;
                                    is-selected: row.is-selected;
                                    is-boundary: row.is-boundary;
                                    clicked => { root.blame-select(index); }
                                }
                            }
                        }
                    }
                }
            }

            // ---------------------------------------------------- Git 日志工具窗
            Rectangle {
                height: 300px;
                background: Palette.panel;

                VerticalLayout {
                    spacing: 0px;

                    // 标签栏
                    Rectangle {
                        height: Metrics.tab-height;
                        background: Palette.bar;

                        HorizontalLayout {
                            padding-left: 4px;
                            padding-right: 4px;
                            spacing: 0px;

                            TabButton {
                                text: "Git";
                                active: root.bottom-tab == 0;
                                clicked => { root.bottom-tab = 0; }
                            }

                            TabButton {
                                text: "Console " + root.console-summary;
                                active: root.bottom-tab == 1;
                                clicked => { root.bottom-tab = 1; }
                            }

                            TabButton {
                                text: "Stash " + root.stash-summary;
                                active: root.bottom-tab == 2;
                                clicked => {
                                    root.bottom-tab = 2;
                                    root.request-stash-list();
                                }
                            }

                            Rectangle { horizontal-stretch: 1; }

                            IdeaIconButton {
                                icon: "refresh";
                                clicked => { root.refresh(); }
                            }

                            IdeaIconButton {
                                icon: "settings";
                                clicked => { root.open-settings(); }
                            }
                        }

                        Rectangle {
                            width: parent.width;
                            height: 1px;
                            y: parent.height - self.height;
                            background: Palette.toolwindow-border;
                        }
                    }

                    // ---- Git 日志
                    HorizontalLayout {
                        vertical-stretch: 1;
                        visible: root.bottom-tab == 0;
                        spacing: 0px;

                        // 分支树 + 分支操作
                        Rectangle {
                            width: root.viewport-width < 1060px ? 190px : 228px;
                            background: Palette.panel;

                            VerticalLayout {
                                height: parent.height;
                                padding: 8px;
                                spacing: 6px;

                                Text {
                                    text: Texts.s14;
                                    color: Palette.text-dim;
                                    font-size: Palette.font-sm;
                                    font-weight: 600;
                                }

                                ListView {
                                    height: 116px;
                                    for entry[index] in root.sidebar-refs: Rectangle {
                                        height: 24px;
                                        background: entry.selected
                                            ? Palette.selection
                                            : (ref-touch.has-hover ? Palette.hover : (entry.is-head ? Palette.log-branch-bg : transparent));
                                        border-radius: Palette.radius-sm;

                                        if entry.row-kind == 0: HorizontalLayout {
                                            padding-left: 2px;
                                            padding-right: 6px;
                                            spacing: 4px;

                                            IdeaIcon {
                                                name: entry.collapsed ? "chevron-right" : "chevron-down";
                                                icon-size: 12px;
                                                tint: Palette.text-faint;
                                            }

                                            Text {
                                                text: entry.group == 0 ? "HEAD"
                                                    : entry.group == 1 ? Texts.s172
                                                    : entry.group == 2 ? Texts.s173
                                                    : entry.group == 3 ? Texts.s174
                                                    : Texts.s187;
                                                color: Palette.text-faint;
                                                font-size: Palette.font-sm;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                            }

                                            Text {
                                                text: entry.count;
                                                color: Palette.text-faint;
                                                font-size: Palette.font-meta;
                                                vertical-alignment: center;
                                            }

                                            Rectangle { horizontal-stretch: 1; }
                                        }

                                        if entry.row-kind == 1: HorizontalLayout {
                                            padding-left: 18px;
                                            padding-right: 6px;
                                            spacing: 6px;

                                            IdeaIcon {
                                                name: entry.kind-id == 2 ? "tag" : "branch";
                                                icon-size: 14px;
                                                tint: entry.kind-id == 2
                                                    ? Palette.ref-tag
                                                    : (entry.kind-id == 1 ? Palette.ref-remote : (entry.is-head ? Palette.ref-head : Palette.ref-local));
                                            }

                                            Text {
                                                horizontal-stretch: 1;
                                                text: entry.name;
                                                color: entry.selected ? Palette.text : Palette.text-dim;
                                                font-size: Palette.font-md;
                                                font-weight: entry.is-head ? 600 : 400;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }

                                            Text {
                                                text: entry.sync;
                                                color: Palette.text-faint;
                                                font-size: Palette.font-meta;
                                                vertical-alignment: center;
                                                horizontal-alignment: right;
                                            }
                                        }

                                        ref-touch := TouchArea {
                                            clicked => {
                                                if entry.row-kind == 0 {
                                                    root.toggle-ref-group(entry.group);
                                                } else if entry.row-kind == 1 {
                                                    root.select-ref(entry.ref-index);
                                                }
                                            }
                                        }
                                    }
                                }

                                Divider { }

                                Field {
                                    text <=> root.branch-input;
                                    placeholder: Texts.s15;
                                    edited(v) => { root.set-branch-input(v); }
                                }

                                HorizontalLayout {
                                    spacing: 4px;
                                    FlatButton { text: Texts.s16; enabled: !root.read-only; clicked => { root.branch-create(true); } }
                                    FlatButton { text: Texts.s17; enabled: !root.read-only; clicked => { root.branch-create(false); } }
                                    FlatButton { text: Texts.s18; enabled: !root.read-only; clicked => { root.branch-checkout(); } }
                                }

                                HorizontalLayout {
                                    spacing: 4px;
                                    FlatButton { text: Texts.s19; enabled: !root.read-only; clicked => { root.branch-rename(); } }
                                    FlatButton { text: Texts.s20; enabled: !root.read-only; danger: true; clicked => { root.branch-delete(false); } }
                                    FlatButton { text: Texts.s21; enabled: !root.read-only; clicked => { root.branch-upstream(); } }
                                }
                            }
                        }

                        VDivider { }

                        // 提交表
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 0px;

                            Rectangle {
                                height: Metrics.toolbar-height;
                                background: Palette.panel;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 4px;

                                    IdeaSearchField {
                                        width: 240px;
                                        text <=> root.search-query;
                                        placeholder: Texts.s25;
                                        regex: root.search-regex;
                                        edited(v) => { root.set-search(v); }
                                        regex-toggled => { root.toggle-search-regex(!root.search-regex); }
                                        accepted => { root.run-search(); }
                                    }

                                    IdeaIconButton {
                                        icon: "search";
                                        clicked => { root.run-search(); }
                                    }

                                    IdeaIconButton {
                                        icon: "close";
                                        enabled: root.search-active;
                                        clicked => { root.clear-search(); }
                                    }

                                    Rectangle { horizontal-stretch: 1; }

                                    OptionToggle {
                                        text: Texts.s30;
                                        checked: root.opt-topo;
                                        toggled => { root.toggle-option(0); }
                                    }

                                    OptionToggle {
                                        text: Texts.s31;
                                        checked: root.opt-first-parent;
                                        toggled => { root.toggle-option(1); }
                                    }

                                    OptionToggle {
                                        text: Texts.s32;
                                        checked: root.opt-hide-merges;
                                        toggled => { root.toggle-option(2); }
                                    }

                                    OptionToggle {
                                        text: Texts.s33;
                                        checked: root.opt-collapse;
                                        toggled => { root.toggle-option(3); }
                                    }

                                    Text {
                                        text: root.log-loading ? Texts.s34 : "";
                                        color: Palette.amber;
                                        font-size: Palette.font-meta;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            Divider { }

                            ListView {
                                height: 235px;
                                for row[index] in root.log-rows: LogRowView {
                                        height: Metrics.log-row-height;
                                        short-id: row.short-id;
                                        subject: row.subject;
                                        author: row.author;
                                        when: row.when;
                                        refs-text: row.refs-text;
                                        refs: row.refs;
                                        refs-more: row.refs-more;
                                        graph: row.graph;
                                        is-selected: row.is-selected;
                                        is-mine: row.is-mine;
                                        is-merge: row.is-merge;
                                        on-current-branch: row.on-current-branch;
                                        clicked => { root.select-log(index); }
                                        context-clicked(x, y) => {
                                            root.select-log(index);
                                            root.open-commit-menu(index, x, y);
                                        }
                                    }
                                }
                            }

                        VDivider {
                            visible: root.viewport-width >= 1080px;
                        }

                        // 提交详情：元数据 + 文件清单（点文件在主差异区打开）
                        Rectangle {
                            width: root.viewport-width >= 1080px ? Metrics.details-panel-width : 0px;
                            visible: root.viewport-width >= 1080px;
                            background: Palette.panel;

                            Text {
                                width: 100%;
                                height: 100%;
                                text: Texts.s175;
                                color: Palette.text-faint;
                                font-size: Palette.font-sm;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                wrap: word-wrap;
                                visible: !root.commit-detail.visible;
                            }

                            if root.commit-detail.visible: VerticalLayout {
                                height: parent.height;
                                padding: 12px;
                                spacing: 6px;

                                Text {
                                    text: root.commit-detail.subject;
                                    color: Palette.text;
                                    font-size: Palette.font-md;
                                    font-weight: 600;
                                    wrap: word-wrap;
                                }

                                Divider { }

                                HorizontalLayout {
                                    spacing: 6px;
                                    Text { width: 48px; text: Texts.s177; color: Palette.text-faint; font-size: Palette.font-meta; vertical-alignment: center; }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: root.commit-detail.author + "  <" + root.commit-detail.email + ">";
                                        color: Palette.text-dim;
                                        font-size: Palette.font-sm;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 6px;
                                    Text { width: 48px; text: Texts.s178; color: Palette.text-faint; font-size: Palette.font-meta; vertical-alignment: center; }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: root.commit-detail.when;
                                        color: Palette.text-dim;
                                        font-size: Palette.font-sm;
                                        vertical-alignment: center;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 6px;
                                    Text { width: 48px; text: Texts.s179; color: Palette.text-faint; font-size: Palette.font-meta; vertical-alignment: center; }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: root.commit-detail.hash;
                                        color: Palette.text-dim;
                                        font-family: Palette.mono-font;
                                        font-size: Palette.font-meta;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 6px;
                                    Text { width: 48px; text: Texts.s180; color: Palette.text-faint; font-size: Palette.font-meta; vertical-alignment: center; }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: root.commit-detail.parents == "" ? "—" : root.commit-detail.parents;
                                        color: Palette.text-dim;
                                        font-family: Palette.mono-font;
                                        font-size: Palette.font-meta;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }

                                Divider { }

                                HorizontalLayout {
                                    spacing: 6px;
                                    Text { text: Texts.s181; color: Palette.text-dim; font-size: Palette.font-sm; font-weight: 600; vertical-alignment: center; }
                                    Text {
                                        text: root.commit-detail.files.length + Texts.s164;
                                        color: Palette.text-faint;
                                        font-size: Palette.font-meta;
                                        vertical-alignment: center;
                                    }
                                }

                                ListView {
                                    height: 88px;
                                    for file[index] in root.commit-detail.files: CommitFileRowView {
                                            height: Metrics.list-row-height;
                                            path: file.path;
                                            code: file.code;
                                            status: file.status;
                                            selected: file.selected;
                                            clicked => { root.select-commit-file(index); }
                                        }
                            }
                        }
                    }
                    }

                    // ---- Console
                    VerticalLayout {
                        vertical-stretch: 1;
                        visible: root.bottom-tab == 1;
                        spacing: 0px;

                        Rectangle {
                            height: 28px;
                            background: Palette.panel;

                            HorizontalLayout {
                                padding-left: 8px;
                                spacing: 4px;

                                FlatButton {
                                    text: Texts.s49;
                                    clicked => { root.export-console(); }
                                }
                                FlatButton {
                                    text: Texts.s50;
                                    clicked => { root.clear-console(); }
                                }
                            }
                        }

                        ListView {
                            vertical-stretch: 1;
                            for row in root.console-rows: ConsoleRowView {
                                height: 22px;
                                route: row.route;
                                summary: row.summary;
                                detail: row.detail;
                                ok: row.ok;
                            }
                        }
                    }

                    // ---- Stash
                    HorizontalLayout {
                        vertical-stretch: 1;
                        visible: root.bottom-tab == 2;
                        spacing: 0px;

                        VerticalLayout {
                            width: 300px;
                            padding: 10px;
                            spacing: 6px;

                            Text {
                                text: Texts.s62;
                                color: Palette.text-dim;
                                font-size: Palette.font-sm;
                                font-weight: 600;
                            }

                            Field {
                                text <=> root.stash-message;
                                placeholder: Texts.s63;
                                edited(v) => { root.set-stash-message(v); }
                            }

                            IdeaCheckbox {
                                text: Texts.s64;
                                checked: root.stash-untracked;
                                toggled => { root.toggle-stash-untracked(!root.stash-untracked); }
                            }

                            FlatButton {
                                text: Texts.s65;
                                enabled: !root.read-only;
                                clicked => { root.stash-create(); }
                            }

                            Text {
                                text: Texts.s66;
                                color: Palette.text-faint;
                                font-size: Palette.font-meta;
                                wrap: word-wrap;
                            }

                            Rectangle { vertical-stretch: 1; }
                        }

                        VDivider { }

                        ListView {
                            horizontal-stretch: 1;
                            for row in root.stash-rows: Rectangle {
                                height: 30px;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 8px;

                                    Text {
                                        width: 86px;
                                        text: row.selector;
                                        color: Palette.text-faint;
                                        font-size: Palette.font-meta;
                                        font-family: Palette.mono-font;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        horizontal-stretch: 1;
                                        text: row.branch == "" ? row.summary : row.summary + "   ·   " + row.branch;
                                        color: Palette.text;
                                        font-size: Palette.font-md;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }

                                    FlatButton { text: Texts.s67; enabled: !root.read-only; clicked => { root.stash-apply(row.index); } }
                                    FlatButton { text: Texts.s68; enabled: !root.read-only; clicked => { root.stash-pop(row.index); } }
                                    FlatButton { text: Texts.s20; danger: true; enabled: !root.read-only; clicked => { root.stash-drop(row.index); } }
                                    FlatButton { text: Texts.s69; enabled: !root.read-only && root.branch-input != ""; clicked => { root.stash-branch(row.index); } }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ---------------------------------------------------- 空状态
        //
        // IDEA 欢迎页形态：顶部一行「搜索 + 打开」，下面是最近项目列表。
        // 每行带彩色字母头像，悬停时右侧出现「⋮」菜单（打开 / 从最近项目移除）。
        if !root.has-repo: Rectangle {
            vertical-stretch: 1;
            background: Palette.bg;

            VerticalLayout {
                spacing: 0;

                // ---- 顶部：搜索 + 打开 ----
                Rectangle {
                    height: 52px;
                    background: Palette.bg;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 8px;
                        cross-axis-alignment: center;

                        IdeaSearchField {
                            width: 420px;
                            height: 32px;
                            show-regex: false;
                            text <=> root.project-search;
                            placeholder: Texts.s192;
                            edited(v) => { root.filter-recent(v); }
                        }

                        Rectangle { horizontal-stretch: 1; }

                        IdeaButton {
                            text: Texts.s46;
                            variant: "outline";
                            height: 32px;
                            clicked => { root.browse-repo(); }
                        }
                    }
                }

                Divider { }

                // ---- 最近项目列表 ----
                Rectangle {
                    vertical-stretch: 1;
                    background: Palette.bg;
                    clip: true;

                    ListView {
                        for entry in root.recent: Rectangle {
                            height: 52px;
                            background: row-touch.has-hover ? Palette.hover : transparent;

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 12px;
                                spacing: 12px;
                                cross-axis-alignment: center;

                                // 彩色字母头像
                                Rectangle {
                                    width: 30px;
                                    height: 30px;
                                    border-radius: 8px;
                                    background: entry.accent;

                                    Text {
                                        text: entry.initials;
                                        color: white;
                                        font-size: Palette.font-sm;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 1px;
                                    alignment: center;

                                    Text {
                                        text: entry.name;
                                        color: Palette.text;
                                        font-size: Palette.font-md;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: entry.path;
                                        color: Palette.text-faint;
                                        font-size: Palette.font-meta;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }

                                // 「⋮」只是视觉：整行只有一个交互层（下面的 row-touch），
                                // 热区按光标横坐标判定。两个交互层互相抢 hover 会闪烁，
                                // 也会让人点不中按钮 —— 这里刻意不做成独立按钮。
                                Rectangle {
                                    width: 34px;
                                    height: 34px;
                                    border-radius: Palette.radius-sm;
                                    background: row-touch.has-hover && row-touch.mouse-x >= row-touch.width - 46px
                                        ? Palette.btn-hover
                                        : transparent;
                                    opacity: row-touch.has-hover
                                        || (root.recent-menu-visible && root.recent-menu-path == entry.path)
                                        ? 1
                                        : 0;

                                    IdeaIcon {
                                        name: "more";
                                        icon-size: 18px;
                                        tint: Palette.icon;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                            }

                            // 唯一交互层：铺满整行，放在内容之后（最上层）。右侧 46px
                            // 是「⋮」热区，其余部分打开仓库。光标横坐标用 `mouse-x`。
                            row-touch := TouchArea {
                                mouse-cursor: row-touch.mouse-x >= row-touch.width - 46px ? pointer : default;
                                clicked => {
                                    if (self.mouse-x >= self.width - 46px) {
                                        root.recent-menu-path = entry.path;
                                        root.recent-menu-x = self.absolute-position.x + self.width - 236px;
                                        root.recent-menu-y = self.absolute-position.y + self.height + 2px;
                                        root.recent-menu-visible = true;
                                    } else {
                                        root.recent-menu-visible = false;
                                        root.use-recent(entry.path);
                                    }
                                }
                            }
                        }
                    }

                    // 空占位：区分「没有记录」与「搜索无结果」。
                    Text {
                        width: 100%;
                        height: 100%;
                        text: root.project-search == "" ? Texts.s191 : Texts.s193;
                        color: Palette.text-faint;
                        font-size: Palette.font-md;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        visible: root.recent.length == 0;
                    }
                }
            }
        }

        // ---------------------------------------------------- 提示条
        Rectangle {
            height: root.toast == "" ? 0px : 24px;
            background: Palette.warn-bg;
            visible: root.toast != "";

            Text {
                x: 12px;
                text: root.toast;
                color: Palette.warn-text;
                font-size: Palette.font-meta;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        // ---------------------------------------------------- 状态栏
        Rectangle {
            height: 22px;
            background: Palette.bar;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: Metrics.space-3;

                Text {
                    text: root.git-text;
                    color: Palette.text-faint;
                    font-size: Palette.font-meta;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                Text {
                    text: root.advanced-label == "" ? "" : "⏳ " + root.advanced-label + Texts.s70;
                    color: Palette.amber;
                    font-size: Palette.font-meta;
                    vertical-alignment: center;
                }

                Text {
                    text: root.has-repo ? root.branch-text : "";
                    color: Palette.text-faint;
                    font-size: Palette.font-meta;
                    vertical-alignment: center;
                }
            }
        }
    }

    // ---------------------------------------------------- 浮层（组件见 dialogs.slint）
    // 声明顺序即 z 序：后声明者在上。保持与重构前一致：
    // 确认 / 设置 / 推送 / 远端 / 上下文菜单 / 操作 / 变基 / 冲突 / 比较。

    ConfirmDialog {
        visible: root.confirm-visible;
        confirm-title: root.confirm-title;
        confirm-detail: root.confirm-detail;
        confirm-danger: root.confirm-danger;
        yes => { root.confirm-yes(); }
        no => { root.confirm-no(); }
    }

    SettingsDialog {
        visible: root.settings-visible;
        dark-theme <=> root.dark-theme;
        set-language-en <=> root.set-language-en;
        staging-mode <=> root.staging-mode;
        set-warn-detached <=> root.set-warn-detached;
        set-warn-crlf <=> root.set-warn-crlf;
        set-update-strategy <=> root.set-update-strategy;
        set-cache-mib <=> root.set-cache-mib;
        set-protected <=> root.set-protected;
        set-diff-tool <=> root.set-diff-tool;
        set-merge-tool <=> root.set-merge-tool;
        set-log-level <=> root.set-log-level;
        set-status: root.set-status;
        toggle-theme(dark) => { root.toggle-theme(dark); }
        apply => { root.apply-settings(); }
        cancel => { root.close-settings(); }
    }

    PushDialog {
        visible: root.push-visible;
        push-rows: root.push-rows;
        push-summary: root.push-summary;
        push-hint: root.push-hint;
        push-protected: root.push-protected;
        push-creates-branch: root.push-creates-branch;
        push-force <=> root.push-force;
        push-set-upstream <=> root.push-set-upstream;
        confirm => { root.push-confirm(); }
        cancel => { root.push-cancel(); }
        toggle-force(on) => { root.toggle-push-force(on); }
        toggle-upstream(on) => { root.toggle-push-upstream(on); }
    }

    RemotesDialog {
        visible: root.remotes-visible;
        remote-rows: root.remote-rows;
        remote-selected: root.remote-selected;
        remote-help: root.remote-help;
        token-host: root.token-host;
        keyring-available: root.keyring-available;
        read-only: root.read-only;
        remote-name-input <=> root.remote-name-input;
        remote-url-input <=> root.remote-url-input;
        token-input <=> root.token-input;
        pull-strategy <=> root.pull-strategy;
        select-remote(index) => { root.select-remote(index); }
        name-edited(v) => { root.set-remote-name(v); }
        url-edited(v) => { root.set-remote-url(v); }
        add => { root.remote-add(); }
        set-url => { root.remote-set-url(); }
        remove => { root.remote-remove(); }
        close => { root.close-remotes(); }
        token-edited(v) => { root.set-token-input(v); }
        save-token => { root.save-token(); }
        forget-token => { root.forget-token(); }
        set-strategy(index) => { root.set-pull-strategy(index); }
    }

    CommitCtxMenu {
        visible: root.ctx-visible;
        ctx-x: root.ctx-x;
        ctx-y: root.ctx-y;
        ctx-is-head: root.ctx-is-head;
        read-only: root.read-only;
        action(label) => { root.commit-action(label); }
        close => { root.close-commit-menu(); }
    }

    OpDialog {
        visible: root.op-visible;
        op-title: root.op-title;
        op-hint: root.op-hint;
        op-placeholder: root.op-placeholder;
        op-placeholder2: root.op-placeholder2;
        op-show-input2: root.op-show-input2;
        op-modes: root.op-modes;
        op-danger: root.op-danger;
        op-input <=> root.op-input;
        op-input2 <=> root.op-input2;
        op-mode <=> root.op-mode;
        mode-changed(index) => { root.set-op-mode(index); }
        input-edited(v) => { root.set-op-input(v); }
        input2-edited(v) => { root.set-op-input2(v); }
        confirm => { root.op-confirm(); }
        cancel => { root.op-cancel(); }
    }

    IplanDialog {
        visible: root.iplan-visible;
        iplan-rows: root.iplan-rows;
        iplan-title: root.iplan-title;
        iplan-summary: root.iplan-summary;
        iplan-message-visible: root.iplan-message-visible;
        iplan-message <=> root.iplan-message;
        read-only: root.read-only;
        select(index) => { root.iplan-select(index); }
        action(row, act) => { root.iplan-action(row, act); }
        message-edited(v) => { root.iplan-set-message(v); }
        confirm => { root.iplan-confirm(); }
        cancel => { root.iplan-cancel(); }
    }

    CflDialog {
        visible: root.cfl-visible;
        cfl-files: root.cfl-files;
        cfl-rows: root.cfl-rows;
        cfl-title: root.cfl-title;
        cfl-summary: root.cfl-summary;
        cfl-manual-visible: root.cfl-manual-visible;
        cfl-block: root.cfl-block;
        cfl-manual <=> root.cfl-manual;
        read-only: root.read-only;
        resolve-all(code) => { root.cfl-resolve-all(code); }
        take-side(code) => { root.cfl-take-side(code); }
        mark-resolved => { root.cfl-mark-resolved(); }
        close => { root.cfl-close(); }
        select(index) => { root.cfl-select(index); }
        resolve(block, code) => { root.cfl-resolve(block, code); }
        pick-block(block) => { root.cfl-pick-block(block); }
        manual-edited(v) => { root.cfl-set-manual(v); }
        apply-manual => { root.cfl-apply-manual(); }
    }

    CompareDialog {
        visible: root.compare-visible;
        compare-rows: root.compare-rows;
        compare-title: root.compare-title;
        compare-browse: root.compare-browse;
        select(index) => { root.compare-select(index); }
        close => { root.compare-close(); }
    }

    FileHistoryDialog {
        visible: root.history-visible;
        history-rows: root.history-rows;
        history-title: root.history-title;
        history-truncated: root.history-truncated;
        history-filter <=> root.history-filter;
        select(index) => { root.history-select(index); }
        set-filter(index) => { root.history-set-filter(index); }
        close => { root.history-close(); }
    }

    RecentCtxMenu {
        visible: root.recent-menu-visible;
        ctx-x: root.recent-menu-x;
        ctx-y: root.recent-menu-y;
        action(label) => {
            root.recent-menu-visible = false;
            if label == "open" {
                root.use-recent(root.recent-menu-path);
            } else if label == "remove" {
                root.remove-recent(root.recent-menu-path);
            }
        }
        close => { root.recent-menu-visible = false; }
    }
}
