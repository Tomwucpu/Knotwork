// Knotwork 主窗口（M2：本地写入）。
//
// 结构自上而下：标题栏 → 横幅（进行中 / 只读 / git 缺失）→ 主体（左：引用+分支操作；右：Log + Diff）
//               → 底部面板（本地更改 + 提交 / Console）→ 状态栏；另有两个遮罩层（确认 / 设置）。
//
// 三条渲染纪律（架构规划第 5 节）：
//   1. 列表全虚拟化 —— 用 ListView，只创建视口内的行；
//   2. 泳道图按行自绘 —— Rust 侧把布局算成"每列一个格子"，界面只负责画；
//   3. 词级高亮按"分段文本"传入 —— 界面不做文本测量，避免每帧重排。
//
// 主题：所有颜色都取自 Palette。Palette.dark 由窗口在 init 与属性变更时写入，
// 因此主题切换是"改一个布尔值"，没有任何重建逻辑。Slint 的 global 是进程级单例，
// 多窗口共享同一主题 —— 这正是我们想要的语义（一个应用一套主题）。

import { CheckBox, ListView } from "std-widgets.slint";

// ---------------------------------------------------------------- 主题

global Palette {
    // 由窗口写入（init / 主题切换时），不作为绑定源，避免多窗口绑定冲突。
    in-out property <bool> dark: true;

    out property <color> bg: dark ? #1e1f22 : #f7f8fa;
    out property <color> panel: dark ? #26272b : #eef0f4;
    out property <color> bar: dark ? #2b2d30 : #e4e7ec;
    out property <color> line: dark ? #3c3f41 : #d7dbe1;
    out property <color> text: dark ? #e8eaed : #1f2328;
    out property <color> text-dim: dark ? #bdc1c6 : #3d4450;
    out property <color> text-faint: dark ? #8b9198 : #6a7280;
    out property <color> accent: dark ? #35507a : #d3e3ff;
    out property <color> accent-text: dark ? #ffffff : #12325e;
    out property <color> green: dark ? #6ee7b7 : #0d7350;
    out property <color> amber: dark ? #f0b429 : #8a5a00;
    out property <color> red: dark ? #f2a6ab : #a01b26;
    out property <color> add-bg: dark ? #1f3a24 : #e6ffed;
    out property <color> del-bg: dark ? #3a1f22 : #ffeef0;
    out property <color> hover: dark ? #2f3136 : #e9ecf1;
    out property <color> border: dark ? #4a4d50 : #c7ccd4;
    out property <color> danger-bg: dark ? #5a2a2a : #ffe1e1;
    out property <color> danger-text: dark ? #ffd4d4 : #8b1111;
    out property <color> warn-bg: dark ? #6b5100 : #fff2cc;
    out property <color> warn-text: dark ? #ffe9a8 : #6b4b00;
    out property <color> seg-changed: dark ? #ffd166 : #a15c00;
    out property <string> mono-font: "Consolas";
    out property <length> mono-size: 11px;
    out property <length> body-size: 12px;
}

// 尺寸常量。
global Metrics {
    out property <length> lane-width: 12px;
    out property <length> log-row-height: 24px;
}

// ---------------------------------------------------------------- 数据结构

// 引用列表 / 分支面板的一行。
export struct RefEntry {
    name: string,
    kind: string,
    is-head: bool,
    sync: string,
    selected: bool,
    // 0 = 本地分支，1 = 远程分支，2 = 标签
    kind-id: int,
}

// 泳道图的一列：0 = 空，1 = 竖向连线，2 = 本行节点。
export struct GraphCell {
    kind: int,
    color: color,
}

// 日志列表的一行。
export struct LogRow {
    short-id: string,
    subject: string,
    author: string,
    when: string,
    refs-text: string,
    is-selected: bool,
    // FR-LOG-06：我的提交加粗、合并提交置灰。
    is-mine: bool,
    is-merge: bool,
    graph: [GraphCell],
}

// 本地更改列表的一行。
export struct ChangeRow {
    path: string,
    code: string,
    bucket: string,
    note: string,
    is-selected: bool,
    is-conflict: bool,
    is-untracked: bool,
}

// Diff 的一行。
//
// `hunk-index` / `line-index` 是"这一行对应哪一块、哪一行"，-1 表示不可选
// （hunk 头、占位行）。Rust 侧据它把点击换算成补丁选择，界面不需要懂 diff 结构。
export struct DiffRow {
    kind: int,
    old-no: string,
    new-no: string,
    segments: [string],
    changed: [bool],
    is-hunk-header: bool,
    hunk-index: int,
    line-index: int,
    selectable: bool,
    selected: bool,
}

// Console 的一行。
export struct ConsoleRow {
    route: string,
    summary: string,
    detail: string,
    ok: bool,
}

// 推送预览的一行（将被推送的提交）。
export struct PushRow {
    short-id: string,
    subject: string,
    author: string,
    when: string,
}

// 远端列表的一行。
export struct RemoteRow {
    name: string,
    url: string,
    detail: string,
    selected: bool,
}

// 最近仓库的一项。
export struct RecentRow {
    name: string,
    path: string,
}

// 贮藏列表的一行（FR-STH）。
export struct StashRow {
    index: int,
    selector: string,
    summary: string,
    branch: string,
}

// 三路编辑器左侧的冲突文件行（FR-CFL-02）。
export struct ConflictFileRow {
    row-index: int,
    path: string,
    code: string,
    hunks: int,
    selected: bool,
}

// 三路编辑器的一行：kind=0 是上下文（只有 result），kind=1 是三栏冲突块。
export struct ConflictRow {
    kind: int,
    block: int,
    label: string,
    ours: string,
    theirs: string,
    result: string,
    decided: bool,
}

// 交互式变基步骤的一行（FR-MRG-03）。
export struct RebaseStepRow {
    row-index: int,
    short-id: string,
    subject: string,
    action: int,
    selected: bool,
    has-message: bool,
}

// 两提交比较 / 快照浏览的文件行（FR-LOG-08）。
export struct CompareRow {
    path: string,
    code: string,
    status: string,
    selected: bool,
}

// ---------------------------------------------------------------- 子组件

component FlatButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> danger: false;
    callback clicked();

    width: max(48px, label.preferred-width + 16px);
    height: 22px;
    background: !root.enabled
        ? (Palette.dark ? #33353a : #e6e8ec)
        : (touch.pressed
            ? (Palette.dark ? #3d3f42 : #d0d4da)
            : (touch.has-hover ? (Palette.dark ? #35373a : #dfe3e9) : Palette.bar));
    border-radius: 3px;
    border-width: 1px;
    border-color: root.danger ? Palette.red : Palette.border;

    label := Text {
        text: root.text;
        color: !root.enabled
            ? Palette.text-faint
            : (root.danger ? Palette.red : Palette.text);
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();

    width: max(120px, label.preferred-width + 20px);
    height: 28px;
    background: root.active ? Palette.panel : transparent;

    label := Text {
        text: root.text;
        color: root.active ? Palette.text : Palette.text-faint;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Rectangle {
        width: 100%;
        height: 2px;
        y: 26px;
        background: Palette.green;
        visible: root.active;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "";
    in property <bool> monospace: false;
    callback edited(string);

    height: 26px;
    background: Palette.bg;
    border-color: Palette.border;
    border-width: 1px;
    border-radius: 3px;

    input := TextInput {
        x: 6px;
        width: parent.width - 12px;
        height: parent.height;
        text <=> root.text;
        single-line: true;
        color: Palette.text;
        font-size: 11px;
        font-family: root.monospace ? Palette.mono-font : "";
        vertical-alignment: center;
        edited => { root.edited(root.text); }
    }
}

component OptionToggle inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    callback toggled();

    width: max(72px, label.preferred-width + 22px);
    height: 22px;
    background: root.checked ? Palette.accent : transparent;
    border-radius: 3px;
    border-width: 1px;
    border-color: root.checked ? Palette.accent : Palette.line;

    label := Text {
        text: (root.checked ? "✓ " : "") + root.text;
        color: root.checked ? Palette.accent-text : Palette.text-faint;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.toggled(); }
    }
}

// 日志行：左侧泳道图 + 提交信息。
// 上下文菜单的一行：左对齐文字 + 悬停高亮。
component CtxMenuItem inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();

    height: 26px;
    background: touch.has-hover && root.enabled ? Palette.hover : transparent;
    border-radius: 3px;

    Text {
        x: 8px;
        width: parent.width - 16px;
        text: root.text;
        color: !root.enabled ? Palette.text-faint : Palette.text;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component LogRowView inherits Rectangle {
    in property <string> short-id;
    in property <string> subject;
    in property <string> author;
    in property <string> when;
    in property <string> refs-text;
    in property <[GraphCell]> graph;
    in property <bool> is-selected;
    in property <bool> is-mine;
    in property <bool> is-merge;
    callback clicked();
    // 右键：提交上下文菜单（FR-LOG-07/08）。带上光标坐标，菜单出现在鼠标处。
    callback context-clicked(length, length);

    background: root.is-selected
        ? (Palette.dark ? #35507a : #cfe0ff)
        : (touch.has-hover ? Palette.hover : transparent);

    HorizontalLayout {
        spacing: 0px;

        // 泳道图：每列一个格子，格子内部自绘连线与节点。
        Rectangle {
            width: root.graph.length * Metrics.lane-width;
            height: 100%;

            HorizontalLayout {
                spacing: 0px;

                for cell in root.graph: Rectangle {
                    width: Metrics.lane-width;

                    Rectangle {
                        x: 5px;
                        width: 2px;
                        height: 100%;
                        background: cell.color;
                        visible: cell.kind == 1 || cell.kind == 2;
                    }

                    Rectangle {
                        x: 1px;
                        y: 7px;
                        width: 9px;
                        height: 9px;
                        border-radius: 5px;
                        background: cell.color;
                        visible: cell.kind == 2;
                    }
                }
            }
        }

        Text {
            width: 62px;
            text: root.short-id;
            color: Palette.text-faint;
            font-size: 11px;
            vertical-alignment: center;
            font-family: Palette.mono-font;
        }

        Text {
            width: 150px;
            text: root.refs-text;
            color: Palette.amber;
            font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            horizontal-stretch: 1;
            text: root.subject;
            // FR-LOG-06：合并提交置灰；我的提交加粗。
            color: root.is-merge ? Palette.text-faint : Palette.text;
            font-size: Palette.body-size;
            font-weight: root.is-mine ? 700 : 400;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            width: 120px;
            text: root.author;
            color: Palette.text-faint;
            font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            width: 130px;
            text: root.when;
            color: Palette.text-faint;
            font-size: 11px;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right) {
                // 菜单贴在该行的左边缘展开：`PointerEvent` 不提供光标坐标，
                // 而"点击哪一行就在哪一行旁边弹出"本来就是上下文菜单的语义。
                root.context-clicked(
                    touch.absolute-position.x + 48px,
                    touch.absolute-position.y);
            }
        }
    }
}

// Diff 行：行号槽 + 分段文本 + 选择高亮。
component DiffRowView inherits Rectangle {
    in property <int> kind;
    in property <string> old-no;
    in property <string> new-no;
    in property <[string]> segments;
    in property <[bool]> changed;
    in property <bool> is-hunk-header;
    in property <bool> selectable;
    in property <bool> selected;
    callback clicked();

    // kind: 0 上下文、1 新增、2 删除、3 元信息
    background: root.is-hunk-header
        ? Palette.bar
        : (root.kind == 1 ? Palette.add-bg : (root.kind == 2 ? Palette.del-bg : transparent));

    // 选中态用左侧色条 + 底色叠加表示，避免盖掉增删行的底色语义。
    Rectangle {
        width: 3px;
        height: 100%;
        background: Palette.amber;
        visible: root.selected;
    }

    HorizontalLayout {
        spacing: 0px;

        Text {
            width: 46px;
            text: root.old-no;
            color: Palette.text-faint;
            font-size: 11px;
            vertical-alignment: center;
            horizontal-alignment: right;
            font-family: Palette.mono-font;
        }

        Text {
            width: 46px;
            text: root.new-no;
            color: Palette.text-faint;
            font-size: 11px;
            vertical-alignment: center;
            horizontal-alignment: right;
            font-family: Palette.mono-font;
        }

        Rectangle { width: 12px; }

        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 0px;

            for segment[i] in root.segments: Text {
                text: segment;
                color: root.changed[i]
                    ? Palette.seg-changed
                    : (root.kind == 2 ? Palette.red : (root.kind == 1 ? Palette.green : Palette.text-dim));
                font-size: Palette.body-size;
                vertical-alignment: center;
                font-family: Palette.mono-font;
            }
        }
    }

    touch := TouchArea {
        enabled: root.selectable;
        clicked => { root.clicked(); }
    }
}

// 本地更改行。
component ChangeRowView inherits Rectangle {
    in property <string> path;
    in property <string> code;
    in property <string> bucket;
    in property <string> note;
    in property <bool> is-selected;
    in property <bool> is-conflict;
    callback clicked();

    background: root.is-selected
        ? (Palette.dark ? #35507a : #cfe0ff)
        : (touch.has-hover ? Palette.hover : transparent);

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;

        Text {
            width: 120px;
            text: root.bucket;
            color: root.is-conflict ? Palette.red : Palette.text-faint;
            font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            width: 26px;
            text: root.code;
            color: Palette.amber;
            font-size: 11px;
            vertical-alignment: center;
            font-family: Palette.mono-font;
        }

        Text {
            horizontal-stretch: 1;
            text: root.path;
            color: Palette.text;
            font-size: Palette.body-size;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            width: 150px;
            text: root.note;
            color: Palette.text-faint;
            font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Console 行。
component ConsoleRowView inherits Rectangle {
    in property <string> route;
    in property <string> summary;
    in property <string> detail;
    in property <bool> ok;

    background: transparent;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;

        Text {
            width: 92px;
            text: root.route;
            color: root.ok ? Palette.green : Palette.red;
            font-size: 11px;
            vertical-alignment: center;
        }

        Text {
            horizontal-stretch: 1;
            text: root.summary;
            color: Palette.text-dim;
            font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
            font-family: Palette.mono-font;
        }

        Text {
            width: 240px;
            text: root.detail;
            color: Palette.text-faint;
            font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// ---------------------------------------------------------------- 主窗口

export component MainWindow inherits Window {
    // ---- 仓库与状态 ----
    in-out property <string> repo-title: "Knotwork";
    in-out property <string> repo-path: "";
    in-out property <string> branch-text: "—";
    in-out property <string> head-text: "—";
    in-out property <string> git-text: "";
    in-out property <string> state-text: "";
    in-out property <bool> state-banner-visible: false;

    // ---- 主题（FR-SET-02 外观组）----
    in-out property <bool> dark-theme: true;

    // ---- 只读模式（FR-MR-04）----
    in-out property <bool> read-only: false;
    in-out property <string> read-only-reason: "";

    // ---- 侧栏 ----
    in-out property <[RefEntry]> sidebar-refs: [];
    in-out property <string> branch-input: "";
    in-out property <int> selected-ref: -1;

    // ---- 空状态（未打开仓库）----
    in-out property <bool> has-repo: false;
    in-out property <string> open-path: "";
    in-out property <string> empty-message: "输入仓库路径后打开，或从下方最近仓库中选择。";
    in-out property <[RecentRow]> recent: [];

    // ---- 日志面板 ----
    in-out property <[LogRow]> log-rows: [];
    in-out property <string> log-summary: "";
    in-out property <int> log-total: 0;
    in-out property <bool> log-loading: false;
    in-out property <string> search-query: "";
    in-out property <bool> search-regex: false;
    in-out property <bool> search-active: false;
    in-out property <bool> opt-topo: false;
    in-out property <bool> opt-first-parent: false;
    in-out property <bool> opt-hide-merges: false;
    in-out property <bool> opt-collapse: false;

    // ---- Diff 面板 ----
    in-out property <[DiffRow]> diff-rows: [];
    in-out property <string> diff-title: "差异";
    in-out property <string> diff-stats: "";
    in-out property <bool> diff-loading: false;
    in-out property <string> diff-hint: "";
    // 当前差异是否来自"已暂存"一侧（决定按钮语义）。
    in-out property <bool> diff-staged-view: false;
    // 当前差异是否支持按块落库（新增/未跟踪文件只能整文件暂存）。
    in-out property <bool> diff-selectable: false;

    // ---- 本地更改 ----
    in-out property <[ChangeRow]> change-rows: [];
    in-out property <string> change-summary: "";
    in-out property <bool> selection-is-untracked: false;

    // ---- 提交（FR-CMT-01/02）----
    in-out property <string> commit-message: "";
    in-out property <bool> commit-amend: false;
    in-out property <bool> commit-reset-author: false;
    in-out property <string> commit-hint: "";
    in-out property <bool> commit-enabled: true;
    in-out property <bool> staging-mode: true;

    // ---- Console ----
    in-out property <[ConsoleRow]> console-rows: [];
    in-out property <string> console-summary: "";

    // ---- 远端（FR-RMT）----
    // 网络操作进行中：显示进度条与取消按钮。
    in-out property <bool> network-busy: false;
    in-out property <string> network-label: "";
    in-out property <string> network-progress: "";
    // 最近一次远端失败（结论 + 建议，多行）。
    in-out property <bool> network-error-visible: false;
    in-out property <string> network-error: "";
    // 当前仓库的远端名（工具栏显示与推送目标）。
    in-out property <[string]> remote-names: [];
    in-out property <string> remote-current: "";
    // 更新策略：0 = 合并，1 = 变基，2 = 仅快进
    in-out property <int> pull-strategy: 0;

    // ---- 远端管理遮罩 ----
    in-out property <bool> remotes-visible: false;
    in-out property <[RemoteRow]> remote-rows: [];
    in-out property <int> remote-selected: -1;
    in-out property <string> remote-name-input: "";
    in-out property <string> remote-url-input: "";
    in-out property <string> remote-help: "";
    in-out property <string> token-host: "";
    in-out property <string> token-input: "";
    in-out property <bool> keyring-available: true;

    // ---- 推送预览遮罩（FR-RMT-03）----
    in-out property <bool> push-visible: false;
    in-out property <[PushRow]> push-rows: [];
    in-out property <string> push-summary: "";
    in-out property <string> push-hint: "";
    in-out property <bool> push-force: false;
    in-out property <bool> push-set-upstream: false;
    in-out property <bool> push-creates-branch: false;
    in-out property <bool> push-protected: false;

    // ---- 底部面板标签：0 = 本地更改，1 = Console ----
    in-out property <int> bottom-tab: 0;

    // ---- 能力提示（FR-STA-04）----
    in-out property <bool> cli-missing: false;
    in-out property <string> cli-missing-reason: "";

    // ---- 提示条 ----
    in-out property <string> toast: "";

    // ---- 二次确认遮罩（FR-LC-02 / D4）----
    in-out property <bool> confirm-visible: false;
    in-out property <string> confirm-title: "确认操作";
    in-out property <string> confirm-detail: "";
    in-out property <bool> confirm-danger: true;

    // ---- 设置遮罩（FR-SET-01/02）----
    in-out property <bool> settings-visible: false;
    in-out property <bool> set-warn-detached: true;
    in-out property <bool> set-warn-crlf: true;
    in-out property <int> set-update-strategy: 0;
    in-out property <int> set-cache-mib: 32;
    in-out property <string> set-protected: "";
    in-out property <string> set-diff-tool: "";
    in-out property <string> set-merge-tool: "";
    in-out property <int> set-log-level: 2;
    in-out property <string> set-status: "";

    // ---- M4：提交上下文菜单（FR-LOG-07/08）----
    in-out property <bool> ctx-visible: false;
    in-out property <length> ctx-x: 0px;
    in-out property <length> ctx-y: 0px;
    in-out property <string> ctx-subject: "";
    in-out property <bool> ctx-is-head: false;

    // ---- M4：通用操作对话框（合并/变基/重置/补丁/标签）----
    // 用一个对话框承载五种"填一个参数再确认"的操作：它们的交互形态完全一致，
    // 分成五个遮罩只会让 Slint 与接线各多五份一模一样的代码。
    in-out property <bool> op-visible: false;
    in-out property <int> op-kind: 0;
    in-out property <string> op-title: "";
    in-out property <string> op-hint: "";
    in-out property <string> op-input: "";
    in-out property <string> op-placeholder: "";
    in-out property <string> op-input2: "";
    in-out property <string> op-placeholder2: "";
    in-out property <bool> op-show-input2: false;
    in-out property <[string]> op-modes: [];
    in-out property <int> op-mode: 0;
    in-out property <bool> op-danger: false;

    // ---- M4：交互式变基编辑器（FR-MRG-03）----
    in-out property <bool> iplan-visible: false;
    in-out property <[RebaseStepRow]> iplan-rows: [];
    in-out property <string> iplan-title: "";
    in-out property <string> iplan-summary: "";
    in-out property <int> iplan-selected: -1;
    in-out property <string> iplan-message: "";
    in-out property <bool> iplan-message-visible: false;

    // ---- M4：三路冲突编辑器（FR-CFL）----
    in-out property <bool> cfl-visible: false;
    in-out property <[ConflictFileRow]> cfl-files: [];
    in-out property <[ConflictRow]> cfl-rows: [];
    in-out property <string> cfl-title: "";
    in-out property <string> cfl-summary: "";
    in-out property <string> cfl-manual: "";
    in-out property <bool> cfl-manual-visible: false;
    in-out property <int> cfl-block: -1;

    // ---- M4：贮藏面板（FR-STH）----
    in-out property <[StashRow]> stash-rows: [];
    in-out property <string> stash-message: "";
    in-out property <bool> stash-untracked: false;
    in-out property <string> stash-summary: "";

    // ---- M4：比较 / 快照浏览（FR-LOG-08）----
    in-out property <bool> compare-visible: false;
    in-out property <[CompareRow]> compare-rows: [];
    in-out property <string> compare-title: "";
    in-out property <bool> compare-browse: false;

    // ---- M4：忙碌与中断恢复 ----
    in-out property <string> advanced-label: "";
    in-out property <bool> resume-visible: false;
    in-out property <bool> resume-can-skip: false;

    callback poll();
    callback refresh();
    callback open-repo(string);
    callback select-log(int);
    callback select-change(int);
    callback select-ref(int);
    callback export-console();
    callback clear-console();
    callback use-recent(string);

    // 写操作
    callback stage-selected();
    callback unstage-selected();
    callback discard-selected();
    callback delete-selected();
    callback ignore-selected(int);
    callback commit();
    callback set-commit-message(string);
    callback toggle-amend(bool);
    callback toggle-reset-author(bool);
    callback toggle-diff-row(int);
    callback stage-hunks();
    callback unstage-hunks();
    callback discard-hunks();
    callback set-branch-input(string);
    callback branch-create(bool);
    callback branch-checkout();
    callback branch-rename();
    callback branch-delete(bool);
    callback branch-upstream();
    callback checkout-selected-commit();
    callback delete-tag();

    // 搜索与图选项
    callback set-search(string);
    callback toggle-search-regex(bool);
    callback run-search();
    callback clear-search();
    callback toggle-option(int);

    // 远端（FR-RMT）
    callback fetch-selected();
    callback fetch-all();
    callback update-project();
    callback push-request();
    callback push-confirm();
    callback push-cancel();
    callback toggle-push-force(bool);
    callback toggle-push-upstream(bool);
    callback set-pull-strategy(int);
    callback select-remote(int);
    callback cancel-network();
    callback dismiss-network-error();
    callback open-remotes();
    callback close-remotes();
    callback set-remote-name(string);
    callback set-remote-url(string);
    callback remote-add();
    callback remote-remove();
    callback remote-set-url();
    callback set-token-input(string);
    callback save-token();
    callback forget-token();

    // 遮罩
    callback confirm-yes();
    callback confirm-no();
    callback open-settings();
    callback close-settings();
    callback apply-settings();
    callback toggle-theme(bool);

    // ---- M4：提交上下文菜单 ----
    callback open-commit-menu(int, length, length);
    callback close-commit-menu();
    // 菜单项统一走一个回调：动作标识由 Rust 侧解释，避免十三个几乎相同的回调。
    callback commit-action(string);

    // ---- M4：通用操作对话框 ----
    callback set-op-input(string);
    callback set-op-input2(string);
    callback set-op-mode(int);
    callback op-confirm();
    callback op-cancel();

    // ---- M4：交互式变基 ----
    callback iplan-select(int);
    callback iplan-action(int, int);
    callback iplan-set-message(string);
    callback iplan-confirm();
    callback iplan-cancel();

    // ---- M4：三路冲突解决 ----
    callback cfl-select(int);
    callback cfl-pick-block(int);
    callback cfl-take-side(int);
    callback cfl-resolve(int, int);
    callback cfl-resolve-all(int);
    callback cfl-set-manual(string);
    callback cfl-apply-manual();
    callback cfl-mark-resolved();
    callback cfl-close();

    // ---- M4：贮藏 ----
    callback request-stash-list();
    callback set-stash-message(string);
    callback toggle-stash-untracked(bool);
    callback stash-create();
    callback stash-apply(int);
    callback stash-pop(int);
    callback stash-drop(int);
    callback stash-branch(int);

    // ---- M4：比较 / 快照浏览 ----
    callback compare-select(int);
    callback compare-close();

    // ---- M4：中断恢复（merge / rebase / cherry-pick / revert）----
    callback resume-continue();
    callback resume-skip();
    callback resume-abort();

    title: repo-title + (read-only ? "（只读）" : "");
    width: 1280px;
    height: 860px;
    background: Palette.bg;

    init => { Palette.dark = root.dark-theme; }
    changed dark-theme => { Palette.dark = root.dark-theme; }

    // 每 100ms 向 Rust 侧要一次异步结果（UI 线程只做搬运，不做 I/O）。
    Timer {
        interval: 100ms;
        running: true;
        triggered => { root.poll(); }
    }

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // ---------------------------------------------------- 标题栏
        Rectangle {
            height: 44px;
            background: Palette.bar;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 10px;
                spacing: 10px;

                VerticalLayout {
                    alignment: center;
                    spacing: 1px;

                    Text {
                        text: root.repo-title;
                        color: Palette.text;
                        font-size: 15px;
                        font-weight: 600;
                    }

                    Text {
                        text: root.repo-path;
                        color: Palette.text-faint;
                        font-size: 11px;
                        overflow: elide;
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                Text {
                    text: root.branch-text;
                    color: Palette.green;
                    font-size: 13px;
                    vertical-alignment: center;
                }

                Text {
                    text: root.head-text;
                    color: Palette.text-faint;
                    font-size: 11px;
                    vertical-alignment: center;
                }

                // ---- 远端操作（FR-RMT-01/02/03）----
                Text {
                    text: root.remote-current;
                    color: Palette.text-faint;
                    font-size: 11px;
                    vertical-alignment: center;
                }

                FlatButton {
                    text: "Fetch";
                    enabled: root.has-repo && !root.cli-missing && !root.network-busy;
                    clicked => { root.fetch-selected(); }
                }

                FlatButton {
                    text: "全部";
                    enabled: root.has-repo && !root.cli-missing && !root.network-busy;
                    clicked => { root.fetch-all(); }
                }

                FlatButton {
                    text: "Update";
                    enabled: root.has-repo && !root.cli-missing && !root.network-busy
                        && !root.read-only;
                    clicked => { root.update-project(); }
                }

                FlatButton {
                    text: "Push";
                    enabled: root.has-repo && !root.cli-missing && !root.network-busy
                        && !root.read-only;
                    clicked => { root.push-request(); }
                }

                FlatButton {
                    text: "远端";
                    enabled: root.has-repo && !root.cli-missing;
                    clicked => { root.open-remotes(); }
                }

                FlatButton {
                    text: "设置";
                    clicked => { root.open-settings(); }
                }

                FlatButton {
                    text: "刷新";
                    clicked => { root.refresh(); }
                }
            }
        }

        // ---------------------------------------------------- 进行中操作横幅
        Rectangle {
            height: root.state-banner-visible ? 28px : 0px;
            background: Palette.warn-bg;
            visible: root.state-banner-visible;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 10px;

                Text {
                    horizontal-stretch: 1;
                    text: root.state-text;
                    color: Palette.warn-text;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }

                FlatButton {
                    text: "继续";
                    visible: root.resume-visible;
                    clicked => { root.resume-continue(); }
                }

                FlatButton {
                    text: "跳过";
                    visible: root.resume-visible && root.resume-can-skip;
                    danger: true;
                    clicked => { root.resume-skip(); }
                }

                FlatButton {
                    text: "中止";
                    visible: root.resume-visible;
                    danger: true;
                    clicked => { root.resume-abort(); }
                }

                FlatButton {
                    text: "查看命令";
                    clicked => { root.bottom-tab = 1; }
                }
            }
        }

        // ---------------------------------------------------- 只读横幅（FR-MR-04）
        Rectangle {
            height: root.read-only ? 28px : 0px;
            background: Palette.danger-bg;
            visible: root.read-only;

            Text {
                x: 14px;
                text: root.read-only-reason;
                color: Palette.danger-text;
                font-size: 12px;
                vertical-alignment: center;
            }
        }

        // ---------------------------------------------------- git 缺失降级提示
        Rectangle {
            height: root.cli-missing ? 44px : 0px;
            background: Palette.danger-bg;
            visible: root.cli-missing;

            Text {
                x: 14px;
                y: 6px;
                width: parent.width - 28px;
                text: root.cli-missing-reason;
                color: Palette.danger-text;
                font-size: 12px;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }

        // ---------------------------------------------------- 网络操作进度（FR-RMT-05）
        Rectangle {
            height: root.network-busy ? 26px : 0px;
            visible: root.network-busy;
            background: Palette.panel;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 10px;
                spacing: 10px;

                Text {
                    text: root.network-label + "…";
                    color: Palette.text;
                    font-size: 11px;
                    vertical-alignment: center;
                }

                Text {
                    horizontal-stretch: 1;
                    text: root.network-progress;
                    color: Palette.text-faint;
                    font-size: 11px;
                    font-family: Palette.mono-font;
                    vertical-alignment: center;
                    overflow: elide;
                }

                FlatButton {
                    text: "取消";
                    danger: true;
                    clicked => { root.cancel-network(); }
                }
            }
        }

        // ---------------------------------------------------- 远端失败提示（结论 + 建议）
        Rectangle {
            height: root.network-error-visible ? 62px : 0px;
            visible: root.network-error-visible;
            background: Palette.danger-bg;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 10px;
                spacing: 10px;

                Text {
                    horizontal-stretch: 1;
                    text: root.network-error;
                    color: Palette.danger-text;
                    font-size: 11px;
                    wrap: word-wrap;
                    overflow: elide;
                }

                FlatButton {
                    text: "关闭";
                    clicked => { root.dismiss-network-error(); }
                }
            }
        }

        // ---------------------------------------------------- 主体
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 0px;

            // 左：引用列表 + 分支操作
            Rectangle {
                width: 258px;
                background: Palette.panel;
                visible: root.has-repo;

                VerticalLayout {
                    padding: 8px;
                    spacing: 6px;

                    Text {
                        text: "分支与标签";
                        color: Palette.text-dim;
                        font-size: 12px;
                        font-weight: 600;
                    }

                    Rectangle { height: 1px; background: Palette.line; }

                    ListView {
                        vertical-stretch: 1;
                        for entry[index] in root.sidebar-refs: Rectangle {
                            height: 22px;
                            background: entry.is-head
                                ? Palette.accent
                                : (entry.selected ? Palette.hover : transparent);

                            Text {
                                x: 6px;
                                width: parent.width - 60px;
                                text: entry.name;
                                color: entry.is-head ? Palette.accent-text : Palette.text-dim;
                                font-size: 12px;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            Text {
                                x: parent.width - 52px;
                                width: 46px;
                                text: entry.sync;
                                color: Palette.text-faint;
                                font-size: 10px;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                            }

                            TouchArea {
                                clicked => { root.select-ref(index); }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: Palette.line; }

                    Field {
                        // 双向绑定：Rust 侧选中分支时会回填名称，用户输入也要能写回属性。
                        text <=> root.branch-input;
                        placeholder: "新分支名 / 新名称";
                        edited(v) => { root.set-branch-input(v); }
                    }

                    HorizontalLayout {
                        spacing: 4px;

                        FlatButton {
                            text: "新建";
                            enabled: !root.read-only;
                            clicked => { root.branch-create(true); }
                        }
                        FlatButton {
                            text: "仅建";
                            enabled: !root.read-only;
                            clicked => { root.branch-create(false); }
                        }
                        FlatButton {
                            text: "检出";
                            enabled: !root.read-only;
                            clicked => { root.branch-checkout(); }
                        }
                    }

                    HorizontalLayout {
                        spacing: 4px;

                        FlatButton {
                            text: "重命名";
                            enabled: !root.read-only;
                            clicked => { root.branch-rename(); }
                        }
                        FlatButton {
                            text: "删除";
                            enabled: !root.read-only;
                            danger: true;
                            clicked => { root.branch-delete(false); }
                        }
                        FlatButton {
                            text: "设上游";
                            enabled: !root.read-only;
                            clicked => { root.branch-upstream(); }
                        }
                    }

                    HorizontalLayout {
                        spacing: 4px;

                        FlatButton {
                            text: "检出所选提交（分离）";
                            enabled: !root.read-only;
                            clicked => { root.checkout-selected-commit(); }
                        }

                        FlatButton {
                            text: "删标签";
                            danger: true;
                            enabled: !root.read-only;
                            clicked => { root.delete-tag(); }
                        }
                    }
                }
            }

            // 右：Log + Diff
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 0px;

                // Log 面板
                VerticalLayout {
                    vertical-stretch: 3;
                    spacing: 0px;

                    Rectangle {
                        height: 30px;
                        background: Palette.bar;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;

                            Text {
                                text: "提交历史";
                                color: Palette.text;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }

                            Text {
                                text: root.log-summary;
                                color: Palette.text-faint;
                                font-size: 11px;
                                vertical-alignment: center;
                            }

                            Rectangle { horizontal-stretch: 1; }

                            Field {
                                width: 200px;
                                text <=> root.search-query;
                                placeholder: "搜索提交消息 / 哈希";
                                monospace: true;
                                edited(v) => { root.set-search(v); }
                            }

                            OptionToggle {
                                text: "正则";
                                checked: root.search-regex;
                                toggled => { root.toggle-search-regex(!root.search-regex); }
                            }

                            FlatButton {
                                text: "搜索";
                                clicked => { root.run-search(); }
                            }

                            FlatButton {
                                text: "清除";
                                enabled: root.search-active;
                                clicked => { root.clear-search(); }
                            }
                        }
                    }

                    // 图选项条（FR-LOG-05/06）
                    Rectangle {
                        height: 26px;
                        background: Palette.panel;

                        HorizontalLayout {
                            padding-left: 10px;
                            spacing: 6px;

                            Text {
                                text: "图选项";
                                color: Palette.text-faint;
                                font-size: 11px;
                                vertical-alignment: center;
                            }

                            OptionToggle {
                                text: "拓扑排序";
                                checked: root.opt-topo;
                                toggled => { root.toggle-option(0); }
                            }
                            OptionToggle {
                                text: "仅第一父";
                                checked: root.opt-first-parent;
                                toggled => { root.toggle-option(1); }
                            }
                            OptionToggle {
                                text: "隐藏合并";
                                checked: root.opt-hide-merges;
                                toggled => { root.toggle-option(2); }
                            }
                            OptionToggle {
                                text: "折叠线性";
                                checked: root.opt-collapse;
                                toggled => { root.toggle-option(3); }
                            }

                            Rectangle { horizontal-stretch: 1; }

                            Text {
                                text: root.log-loading ? "加载中…" : "";
                                color: Palette.amber;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle { height: 1px; background: Palette.line; }

                    ListView {
                        vertical-stretch: 1;
                        for row[index] in root.log-rows: LogRowView {
                            height: Metrics.log-row-height;
                            short-id: row.short-id;
                            subject: row.subject;
                            author: row.author;
                            when: row.when;
                            refs-text: row.refs-text;
                            graph: row.graph;
                            is-selected: row.is-selected;
                            is-mine: row.is-mine;
                            is-merge: row.is-merge;
                            clicked => { root.select-log(index); }
                            context-clicked(x, y) => {
                                root.select-log(index);
                                root.open-commit-menu(index, x, y);
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: Palette.line; }

                // Diff 面板
                VerticalLayout {
                    vertical-stretch: 2;
                    spacing: 0px;

                    Rectangle {
                        height: 30px;
                        background: Palette.bar;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;

                            Text {
                                width: 210px;
                                text: root.diff-title;
                                color: Palette.text;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            Text {
                                text: root.diff-stats;
                                color: Palette.text-faint;
                                font-size: 11px;
                                vertical-alignment: center;
                            }

                            Rectangle { horizontal-stretch: 1; }

                            Text {
                                text: root.diff-hint;
                                color: Palette.text-faint;
                                font-size: 11px;
                                vertical-alignment: center;
                            }

                            FlatButton {
                                text: "暂存所选";
                                enabled: !root.read-only && root.diff-selectable
                                    && !root.diff-staged-view && root.staging-mode;
                                clicked => { root.stage-hunks(); }
                            }
                            FlatButton {
                                text: "反暂存所选";
                                enabled: !root.read-only && root.diff-selectable && root.diff-staged-view;
                                clicked => { root.unstage-hunks(); }
                            }
                            FlatButton {
                                text: "丢弃所选";
                                enabled: !root.read-only && root.diff-selectable && !root.diff-staged-view;
                                danger: true;
                                clicked => { root.discard-hunks(); }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: Palette.line; }

                    ListView {
                        vertical-stretch: 1;
                        for row[index] in root.diff-rows: DiffRowView {
                            height: 18px;
                            kind: row.kind;
                            old-no: row.old-no;
                            new-no: row.new-no;
                            segments: row.segments;
                            changed: row.changed;
                            is-hunk-header: row.is-hunk-header;
                            selectable: row.selectable;
                            selected: row.selected;
                            clicked => { root.toggle-diff-row(index); }
                        }
                    }
                }
            }
        }

        // ---------------------------------------------------- 空状态
        Rectangle {
            vertical-stretch: 1;
            background: Palette.bg;
            visible: !root.has-repo;

            VerticalLayout {
                padding: 28px;
                spacing: 12px;
                alignment: center;

                Text {
                    text: "未打开仓库";
                    color: Palette.text;
                    font-size: 18px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.empty-message;
                    color: Palette.text-faint;
                    font-size: 12px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;

                    Rectangle {
                        width: 460px;
                        height: 30px;
                        background: Palette.panel;
                        border-color: Palette.border;
                        border-width: 1px;
                        border-radius: 3px;

                        TextInput {
                            x: 8px;
                            width: parent.width - 16px;
                            height: parent.height;
                            text <=> root.open-path;
                            single-line: true;
                            color: Palette.text;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }

                    FlatButton {
                        text: "打开";
                        clicked => { root.open-repo(root.open-path); }
                    }
                }

                Text {
                    text: "最近仓库";
                    color: Palette.text-dim;
                    font-size: 12px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }

                Rectangle {
                    width: 520px;
                    height: 200px;
                    background: Palette.panel;
                    border-color: Palette.line;
                    border-width: 1px;

                    ListView {
                        for entry in root.recent: Rectangle {
                            height: 26px;
                            background: recent-touch.has-hover ? Palette.hover : transparent;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 10px;

                                Text {
                                    text: entry.name;
                                    color: Palette.text;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }

                                Text {
                                    horizontal-stretch: 1;
                                    text: entry.path;
                                    color: Palette.text-faint;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }

                            recent-touch := TouchArea {
                                clicked => { root.use-recent(entry.path); }
                            }
                        }
                    }
                }
            }
        }

        Rectangle { height: 1px; background: Palette.line; }

        // ---------------------------------------------------- 底部面板
        Rectangle {
            height: root.has-repo ? 300px : 0px;
            background: Palette.panel;
            visible: root.has-repo;

            VerticalLayout {
                padding: 0px;
                spacing: 0px;

                Rectangle {
                    height: 28px;
                    background: Palette.bar;

                    HorizontalLayout {
                        padding-left: 8px;
                        spacing: 4px;

                        TabButton {
                            text: "本地更改 " + root.change-summary;
                            active: root.bottom-tab == 0;
                            clicked => { root.bottom-tab = 0; }
                        }

                        TabButton {
                            text: "Console " + root.console-summary;
                            active: root.bottom-tab == 1;
                            clicked => { root.bottom-tab = 1; }
                        }

                        TabButton {
                            text: "Stash " + root.stash-summary;
                            active: root.bottom-tab == 2;
                            clicked => {
                                root.bottom-tab = 2;
                                root.request-stash-list();
                            }
                        }

                        Rectangle { horizontal-stretch: 1; }

                        FlatButton {
                            text: "导出日志";
                            visible: root.bottom-tab == 1;
                            clicked => { root.export-console(); }
                        }

                        FlatButton {
                            text: "清空";
                            visible: root.bottom-tab == 1;
                            clicked => { root.clear-console(); }
                        }
                    }
                }

                // ---- 本地更改
                HorizontalLayout {
                    vertical-stretch: 1;
                    visible: root.bottom-tab == 0;
                    spacing: 0px;

                    // 左：操作栏 + 列表
                    VerticalLayout {
                        horizontal-stretch: 3;
                        spacing: 0px;

                        Rectangle {
                            height: 26px;
                            background: Palette.panel;

                            HorizontalLayout {
                                padding-left: 6px;
                                spacing: 4px;

                                FlatButton {
                                    text: "暂存";
                                    enabled: !root.read-only;
                                    clicked => { root.stage-selected(); }
                                }
                                FlatButton {
                                    text: "反暂存";
                                    enabled: !root.read-only;
                                    clicked => { root.unstage-selected(); }
                                }
                                FlatButton {
                                    text: "丢弃";
                                    enabled: !root.read-only;
                                    danger: true;
                                    clicked => { root.discard-selected(); }
                                }
                                FlatButton {
                                    text: "删除未跟踪";
                                    enabled: !root.read-only && root.selection-is-untracked;
                                    danger: true;
                                    clicked => { root.delete-selected(); }
                                }
                                FlatButton {
                                    text: "加入 .gitignore";
                                    enabled: !root.read-only && root.selection-is-untracked;
                                    clicked => { root.ignore-selected(0); }
                                }
                                FlatButton {
                                    text: "加入 exclude";
                                    enabled: !root.read-only && root.selection-is-untracked;
                                    clicked => { root.ignore-selected(1); }
                                }

                                Rectangle { horizontal-stretch: 1; }
                            }
                        }

                        ListView {
                            vertical-stretch: 1;
                            for row[index] in root.change-rows: ChangeRowView {
                                height: 22px;
                                path: row.path;
                                code: row.code;
                                bucket: row.bucket;
                                note: row.note;
                                is-selected: row.is-selected;
                                is-conflict: row.is-conflict;
                                clicked => { root.select-change(index); }
                            }
                        }
                    }

                    Rectangle { width: 1px; background: Palette.line; }

                    // 右：提交面板
                    VerticalLayout {
                        width: 330px;
                        padding: 8px;
                        spacing: 6px;

                        Text {
                            text: "提交消息";
                            color: Palette.text-dim;
                            font-size: 11px;
                        }

                        Rectangle {
                            vertical-stretch: 1;
                            background: Palette.bg;
                            border-color: Palette.border;
                            border-width: 1px;
                            border-radius: 3px;

                            TextInput {
                                x: 6px;
                                y: 4px;
                                width: parent.width - 12px;
                                height: parent.height - 8px;
                                text <=> root.commit-message;
                                single-line: false;
                                wrap: word-wrap;
                                color: Palette.text;
                                font-size: 12px;
                                font-family: Palette.mono-font;
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;

                            CheckBox {
                                text: "修订上次提交";
                                checked: root.commit-amend;
                                toggled => { root.toggle-amend(!root.commit-amend); }
                            }

                            CheckBox {
                                text: "重置作者";
                                checked: root.commit-reset-author;
                                enabled: root.commit-amend;
                                toggled => { root.toggle-reset-author(!root.commit-reset-author); }
                            }
                        }

                        Text {
                            text: root.commit-hint;
                            color: Palette.text-faint;
                            font-size: 11px;
                            wrap: word-wrap;
                        }

                        FlatButton {
                            text: root.commit-amend ? "修订提交" : "提交";
                            enabled: !root.read-only && root.commit-enabled && root.cli-missing == false;
                            clicked => { root.commit(); }
                        }
                    }
                }

                // ---- Console
                ListView {
                    vertical-stretch: 1;
                    visible: root.bottom-tab == 1;
                    for row in root.console-rows: ConsoleRowView {
                        height: 20px;
                        route: row.route;
                        summary: row.summary;
                        detail: row.detail;
                        ok: row.ok;
                    }
                }

                // ---- 贮藏（FR-STH）
                HorizontalLayout {
                    vertical-stretch: 1;
                    visible: root.bottom-tab == 2;
                    spacing: 0px;

                    VerticalLayout {
                        width: 310px;
                        padding: 8px;
                        spacing: 6px;

                        Text {
                            text: "新建贮藏";
                            color: Palette.text-dim;
                            font-size: 11px;
                        }

                        Field {
                            text <=> root.stash-message;
                            placeholder: "消息（可留空）";
                            edited(v) => { root.set-stash-message(v); }
                        }

                        CheckBox {
                            text: "包含未跟踪文件（-u）";
                            checked: root.stash-untracked;
                            toggled => { root.toggle-stash-untracked(!root.stash-untracked); }
                        }

                        FlatButton {
                            text: "创建贮藏";
                            enabled: !root.read-only;
                            clicked => { root.stash-create(); }
                        }

                        Text {
                            text: "贮藏会清空工作区；应用后仍需自行提交。\n从贮藏创建分支可把改动固定到一个新分支上。";
                            color: Palette.text-faint;
                            font-size: 10px;
                            wrap: word-wrap;
                        }

                        Rectangle { vertical-stretch: 1; }
                    }

                    Rectangle { width: 1px; background: Palette.line; }

                    ListView {
                        horizontal-stretch: 1;
                        for row in root.stash-rows: Rectangle {
                            height: 30px;
                            background: transparent;

                            Text {
                                x: 8px;
                                width: 86px;
                                text: row.selector;
                                color: Palette.text-faint;
                                font-size: 11px;
                                font-family: Palette.mono-font;
                                vertical-alignment: center;
                            }

                            Text {
                                x: 98px;
                                width: parent.width - 380px;
                                text: row.branch == "" ? row.summary : row.summary + "   ·   " + row.branch;
                                color: Palette.text;
                                font-size: 12px;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            HorizontalLayout {
                                x: parent.width - 276px;
                                width: 270px;
                                spacing: 4px;

                                FlatButton {
                                    text: "应用";
                                    enabled: !root.read-only;
                                    clicked => { root.stash-apply(row.index); }
                                }
                                FlatButton {
                                    text: "弹出";
                                    enabled: !root.read-only;
                                    clicked => { root.stash-pop(row.index); }
                                }
                                FlatButton {
                                    text: "删除";
                                    danger: true;
                                    enabled: !root.read-only;
                                    clicked => { root.stash-drop(row.index); }
                                }
                                FlatButton {
                                    text: "建分支";
                                    enabled: !root.read-only && root.branch-input != "";
                                    clicked => { root.stash-branch(row.index); }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ---------------------------------------------------- 提示条
        Rectangle {
            height: root.toast == "" ? 0px : 24px;
            background: Palette.warn-bg;
            visible: root.toast != "";

            Text {
                x: 12px;
                text: root.toast;
                color: Palette.warn-text;
                font-size: 11px;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        // ---------------------------------------------------- 状态栏
        Rectangle {
            height: 22px;
            background: Palette.bar;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 12px;

                Text {
                    text: root.git-text;
                    color: Palette.text-faint;
                    font-size: 11px;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                Text {
                    text: root.advanced-label == "" ? "" : "⏳ " + root.advanced-label + " 进行中";
                    color: Palette.amber;
                    font-size: 11px;
                    vertical-alignment: center;
                }

                Text {
                    text: root.has-repo ? root.branch-text : "";
                    color: Palette.text-faint;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
        }
    }

    // ---------------------------------------------------- 二次确认遮罩
    Rectangle {
        visible: root.confirm-visible;
        background: #00000099;

        // 吃掉遮罩层的点击，避免点穿到底下的列表上。
        TouchArea {}

        Rectangle {
            width: min(parent.width - 80px, 520px);
            height: min(parent.height - 80px, 240px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Palette.panel;
            border-color: root.confirm-danger ? Palette.red : Palette.border;
            border-width: 1px;
            border-radius: 6px;

            VerticalLayout {
                padding: 18px;
                spacing: 12px;

                Text {
                    text: root.confirm-title;
                    color: root.confirm-danger ? Palette.red : Palette.text;
                    font-size: 15px;
                    font-weight: 600;
                    wrap: word-wrap;
                }

                Rectangle { height: 1px; background: Palette.line; }

                Text {
                    vertical-stretch: 1;
                    text: root.confirm-detail;
                    color: Palette.text-dim;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    FlatButton {
                        text: "取消";
                        clicked => { root.confirm-no(); }
                    }
                    FlatButton {
                        text: "确认执行";
                        danger: root.confirm-danger;
                        clicked => { root.confirm-yes(); }
                    }
                }
            }
        }
    }

    // ---------------------------------------------------- 设置遮罩（FR-SET）
    Rectangle {
        visible: root.settings-visible;
        background: #00000099;

        TouchArea {}

        Rectangle {
            width: min(parent.width - 80px, 620px);
            height: min(parent.height - 60px, 540px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Palette.panel;
            border-color: Palette.border;
            border-width: 1px;
            border-radius: 6px;

            VerticalLayout {
                padding: 18px;
                spacing: 10px;

                Text {
                    text: "设置";
                    color: Palette.text;
                    font-size: 15px;
                    font-weight: 600;
                }

                Rectangle { height: 1px; background: Palette.line; }

                // 外观
                Text { text: "外观"; color: Palette.text-dim; font-size: 12px; font-weight: 600; }
                HorizontalLayout {
                    spacing: 8px;

                    CheckBox {
                        text: "深色主题（即时生效）";
                        checked: root.dark-theme;
                        toggled => { root.toggle-theme(!root.dark-theme); }
                    }
                }

                // Git 行为
                Text { text: "Git 行为"; color: Palette.text-dim; font-size: 12px; font-weight: 600; }
                HorizontalLayout {
                    spacing: 8px;

                    CheckBox {
                        text: "staging 模式（hunk 级暂存）";
                        checked: root.staging-mode;
                        toggled => { root.staging-mode = !root.staging-mode; }
                    }
                    CheckBox {
                        text: "分离头指针提交告警";
                        checked: root.set-warn-detached;
                        toggled => { root.set-warn-detached = !root.set-warn-detached; }
                    }
                    CheckBox {
                        text: "CRLF 告警";
                        checked: root.set-warn-crlf;
                        toggled => { root.set-warn-crlf = !root.set-warn-crlf; }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;

                    Text {
                        text: "更新策略";
                        color: Palette.text-faint;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    OptionToggle {
                        text: "merge";
                        checked: root.set-update-strategy == 0;
                        toggled => { root.set-update-strategy = 0; }
                    }
                    OptionToggle {
                        text: "rebase";
                        checked: root.set-update-strategy == 1;
                        toggled => { root.set-update-strategy = 1; }
                    }
                    OptionToggle {
                        text: "仅快进";
                        checked: root.set-update-strategy == 2;
                        toggled => { root.set-update-strategy = 2; }
                    }
                }

                // 受保护分支 / 缓存
                Text { text: "受保护分支（正则，逗号分隔）"; color: Palette.text-dim; font-size: 12px; font-weight: 600; }
                Field {
                    text <=> root.set-protected;
                    placeholder: "^main$,^release/";
                    monospace: true;
                }

                HorizontalLayout {
                    spacing: 8px;

                    Text {
                        text: "缓存预算 (MiB)";
                        color: Palette.text-faint;
                        font-size: 11px;
                        vertical-alignment: center;
                    }

                    OptionToggle {
                        text: "8";
                        checked: root.set-cache-mib == 8;
                        toggled => { root.set-cache-mib = 8; }
                    }
                    OptionToggle {
                        text: "16";
                        checked: root.set-cache-mib == 16;
                        toggled => { root.set-cache-mib = 16; }
                    }
                    OptionToggle {
                        text: "32";
                        checked: root.set-cache-mib == 32;
                        toggled => { root.set-cache-mib = 32; }
                    }
                    OptionToggle {
                        text: "64";
                        checked: root.set-cache-mib == 64;
                        toggled => { root.set-cache-mib = 64; }
                    }

                    Text {
                        text: "日志级别";
                        color: Palette.text-faint;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    OptionToggle {
                        text: "info";
                        checked: root.set-log-level == 2;
                        toggled => { root.set-log-level = 2; }
                    }
                    OptionToggle {
                        text: "debug";
                        checked: root.set-log-level == 3;
                        toggled => { root.set-log-level = 3; }
                    }
                }

                // 外部工具
                Text { text: "外部工具（留空则用内置视图）"; color: Palette.text-dim; font-size: 12px; font-weight: 600; }
                Field {
                    text <=> root.set-diff-tool;
                    placeholder: "外部 diff 命令";
                    monospace: true;
                }
                Field {
                    text <=> root.set-merge-tool;
                    placeholder: "外部 merge 命令";
                    monospace: true;
                }

                Text {
                    text: root.set-status;
                    color: Palette.text-faint;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    FlatButton {
                        text: "取消";
                        clicked => { root.close-settings(); }
                    }
                    FlatButton {
                        text: "保存并应用";
                        clicked => { root.apply-settings(); }
                    }
                }
            }
        }
    }

    // ---------------------------------------------------- 推送预览遮罩（FR-RMT-03）
    Rectangle {
        visible: root.push-visible;
        background: #00000099;

        TouchArea {}

        Rectangle {
            width: min(parent.width - 80px, 720px);
            height: min(parent.height - 60px, 520px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Palette.panel;
            border-color: Palette.border;
            border-width: 1px;
            border-radius: 6px;

            VerticalLayout {
                padding: 18px;
                spacing: 10px;

                Text {
                    text: "推送预览";
                    color: Palette.text;
                    font-size: 15px;
                    font-weight: 600;
                }

                Text {
                    text: root.push-summary;
                    color: Palette.text-dim;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                Rectangle { height: 1px; background: Palette.line; }

                ListView {
                    vertical-stretch: 1;
                    for row in root.push-rows: Rectangle {
                        height: 22px;

                        HorizontalLayout {
                            padding-left: 4px;
                            spacing: 8px;

                            Text {
                                width: 70px;
                                text: row.short-id;
                                color: Palette.text-faint;
                                font-size: 11px;
                                font-family: Palette.mono-font;
                                vertical-alignment: center;
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: row.subject;
                                color: Palette.text;
                                font-size: 12px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                width: 90px;
                                text: row.author;
                                color: Palette.text-faint;
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                width: 80px;
                                text: row.when;
                                color: Palette.text-faint;
                                font-size: 11px;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 14px;

                    CheckBox {
                        text: "强制（force-with-lease）";
                        checked: root.push-force;
                        toggled => { root.toggle-push-force(!root.push-force); }
                    }
                    CheckBox {
                        text: "设置上游（-u）";
                        checked: root.push-set-upstream;
                        toggled => { root.toggle-push-upstream(!root.push-set-upstream); }
                    }
                }

                Text {
                    text: root.push-hint;
                    color: root.push-protected ? Palette.amber : Palette.text-faint;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    FlatButton {
                        text: "取消";
                        clicked => { root.push-cancel(); }
                    }
                    FlatButton {
                        text: "推送";
                        enabled: root.push-rows.length > 0 || root.push-creates-branch;
                        clicked => { root.push-confirm(); }
                    }
                }
            }
        }
    }

    // ---------------------------------------------------- 远端管理遮罩（FR-RMT-01/04）
    Rectangle {
        visible: root.remotes-visible;
        background: #00000099;

        TouchArea {}

        Rectangle {
            width: min(parent.width - 80px, 700px);
            height: min(parent.height - 60px, 540px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Palette.panel;
            border-color: Palette.border;
            border-width: 1px;
            border-radius: 6px;

            VerticalLayout {
                padding: 18px;
                spacing: 10px;

                Text {
                    text: "远端管理";
                    color: Palette.text;
                    font-size: 15px;
                    font-weight: 600;
                }

                Rectangle { height: 1px; background: Palette.line; }

                ListView {
                    vertical-stretch: 1;
                    for entry[index] in root.remote-rows: Rectangle {
                        height: 26px;
                        background: entry.selected ? Palette.hover : transparent;

                        HorizontalLayout {
                            padding-left: 6px;
                            spacing: 8px;

                            Text {
                                width: 110px;
                                text: entry.name;
                                color: Palette.text;
                                font-size: 12px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: entry.url;
                                color: Palette.text-dim;
                                font-size: 11px;
                                font-family: Palette.mono-font;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                width: 150px;
                                text: entry.detail;
                                color: Palette.text-faint;
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        TouchArea {
                            clicked => { root.select-remote(index); }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;

                    Field {
                        width: 140px;
                        text <=> root.remote-name-input;
                        placeholder: "名称（origin）";
                        edited(v) => { root.set-remote-name(v); }
                    }
                    Field {
                        horizontal-stretch: 1;
                        text <=> root.remote-url-input;
                        placeholder: "地址（https://… 或 git@host:owner/repo）";
                        monospace: true;
                        edited(v) => { root.set-remote-url(v); }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;

                    FlatButton {
                        text: "添加";
                        enabled: !root.read-only;
                        clicked => { root.remote-add(); }
                    }
                    FlatButton {
                        text: "改地址";
                        enabled: !root.read-only && root.remote-selected >= 0;
                        clicked => { root.remote-set-url(); }
                    }
                    FlatButton {
                        text: "删除";
                        danger: true;
                        enabled: !root.read-only && root.remote-selected >= 0;
                        clicked => { root.remote-remove(); }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    FlatButton {
                        text: "关闭";
                        clicked => { root.close-remotes(); }
                    }
                }

                Rectangle { height: 1px; background: Palette.line; }

                Text {
                    text: "更新策略（记忆用户选择，FR-RMT-02）";
                    color: Palette.text-dim;
                    font-size: 12px;
                    font-weight: 600;
                }

                HorizontalLayout {
                    spacing: 6px;

                    OptionToggle {
                        text: "合并";
                        checked: root.pull-strategy == 0;
                        toggled => { root.set-pull-strategy(0); }
                    }
                    OptionToggle {
                        text: "变基";
                        checked: root.pull-strategy == 1;
                        toggled => { root.set-pull-strategy(1); }
                    }
                    OptionToggle {
                        text: "仅快进";
                        checked: root.pull-strategy == 2;
                        toggled => { root.set-pull-strategy(2); }
                    }
                }

                Text {
                    text: root.remote-help;
                    color: Palette.text-faint;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                Text {
                    text: "HTTPS token（存入系统密钥链；明文不落盘）· 目标主机："
                        + (root.token-host == "" ? "（非 HTTPS 远端）" : root.token-host);
                    color: Palette.text-dim;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 6px;

                    Field {
                        horizontal-stretch: 1;
                        text <=> root.token-input;
                        placeholder: "访问 token";
                        monospace: true;
                        edited(v) => { root.set-token-input(v); }
                    }
                    FlatButton {
                        text: "保存 token";
                        enabled: root.keyring-available && root.token-host != ""
                            && root.token-input != "";
                        clicked => { root.save-token(); }
                    }
                    FlatButton {
                        text: "删除 token";
                        enabled: root.keyring-available && root.token-host != "";
                        clicked => { root.forget-token(); }
                    }
                }
            }
        }
    }

    // ------------------------------------------------ 提交上下文菜单（FR-LOG-07/08）
    Rectangle {
        visible: root.ctx-visible;
        background: transparent;

        // 点空白处关闭；这层必须在菜单面板**之前**声明，否则会盖住菜单。
        TouchArea {
            clicked => { root.close-commit-menu(); }
        }

        Rectangle {
            width: 236px;
            height: menu.preferred-height + 8px;
            x: min(root.ctx-x, root.width - 248px);
            y: min(root.ctx-y, root.height - self.height - 16px);
            background: Palette.panel;
            border-color: Palette.border;
            border-width: 1px;
            border-radius: 4px;

            menu := VerticalLayout {
                x: 4px;
                y: 4px;
                width: parent.width - 8px;
                spacing: 1px;

                CtxMenuItem {
                    text: "合并到当前分支…";
                    enabled: !root.read-only;
                    clicked => { root.commit-action("merge"); }
                }
                CtxMenuItem {
                    text: "变基到此处";
                    enabled: !root.read-only;
                    clicked => { root.commit-action("rebase"); }
                }
                CtxMenuItem {
                    text: "从此处交互式变基…";
                    enabled: !root.read-only;
                    clicked => { root.commit-action("iplan"); }
                }
                CtxMenuItem {
                    text: "拣选此提交";
                    enabled: !root.read-only;
                    clicked => { root.commit-action("cherry-pick"); }
                }
                CtxMenuItem {
                    text: "回滚此提交";
                    enabled: !root.read-only;
                    clicked => { root.commit-action("revert"); }
                }
                CtxMenuItem {
                    text: "重置当前分支到此…";
                    enabled: !root.read-only;
                    clicked => { root.commit-action("reset"); }
                }
                CtxMenuItem {
                    text: "撤销此提交（软重置）";
                    enabled: !root.read-only && root.ctx-is-head;
                    clicked => { root.commit-action("undo"); }
                }

                Rectangle { height: 1px; background: Palette.line; }

                CtxMenuItem {
                    text: "生成补丁…";
                    clicked => { root.commit-action("patch"); }
                }
                CtxMenuItem {
                    text: "新建标签…";
                    enabled: !root.read-only;
                    clicked => { root.commit-action("tag"); }
                }
                CtxMenuItem {
                    text: "应用补丁…";
                    enabled: !root.read-only;
                    clicked => { root.commit-action("apply-patch"); }
                }
                CtxMenuItem {
                    text: "与当前工作区比较";
                    clicked => { root.commit-action("compare"); }
                }
                CtxMenuItem {
                    text: "浏览此版本（只读）";
                    clicked => { root.commit-action("browse"); }
                }

                Rectangle { height: 1px; background: Palette.line; }

                CtxMenuItem {
                    text: "复制哈希";
                    clicked => { root.commit-action("copy"); }
                }
                CtxMenuItem {
                    text: "检出（分离头指针）";
                    enabled: !root.read-only;
                    clicked => { root.commit-action("checkout"); }
                }
            }
        }
    }

    // ------------------------------------------------ 通用操作对话框
    Rectangle {
        visible: root.op-visible;
        background: #00000099;

        TouchArea {}

        Rectangle {
            width: min(parent.width - 80px, 520px);
            height: min(parent.height - 80px, 320px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Palette.panel;
            border-color: root.op-danger ? Palette.red : Palette.border;
            border-width: 1px;
            border-radius: 6px;

            VerticalLayout {
                padding: 18px;
                spacing: 10px;

                Text {
                    text: root.op-title;
                    color: Palette.text;
                    font-size: 15px;
                    font-weight: 600;
                    wrap: word-wrap;
                }

                Text {
                    text: root.op-hint;
                    color: Palette.text-faint;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                Rectangle { height: 1px; background: Palette.line; }

                HorizontalLayout {
                    spacing: 6px;
                    visible: root.op-modes.length > 0;

                    for mode-label[index] in root.op-modes: TabButton {
                        // 显式给宽：TabButton 默认最小 120px，四个模式会撑破对话框。
                        width: 108px;
                        text: mode-label;
                        active: root.op-mode == index;
                        clicked => { root.set-op-mode(index); }
                    }
                }

                Field {
                    text <=> root.op-input;
                    placeholder: root.op-placeholder;
                    monospace: true;
                    edited(v) => { root.set-op-input(v); }
                }

                Field {
                    visible: root.op-show-input2;
                    text <=> root.op-input2;
                    placeholder: root.op-placeholder2;
                    edited(v) => { root.set-op-input2(v); }
                }

                Rectangle { vertical-stretch: 1; }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    FlatButton {
                        text: "取消";
                        clicked => { root.op-cancel(); }
                    }
                    FlatButton {
                        text: "执行";
                        danger: root.op-danger;
                        clicked => { root.op-confirm(); }
                    }
                }
            }
        }
    }

    // ------------------------------------------------ 交互式变基编辑器（FR-MRG-03）
    Rectangle {
        visible: root.iplan-visible;
        background: #00000099;

        TouchArea {}

        Rectangle {
            width: min(parent.width - 60px, 980px);
            height: min(parent.height - 60px, 620px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Palette.panel;
            border-color: Palette.border;
            border-width: 1px;
            border-radius: 6px;

            VerticalLayout {
                padding: 16px;
                spacing: 8px;

                Text {
                    text: root.iplan-title;
                    color: Palette.text;
                    font-size: 15px;
                    font-weight: 600;
                }

                Text {
                    text: root.iplan-summary;
                    color: Palette.text-faint;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                Rectangle { height: 1px; background: Palette.line; }

                ListView {
                    vertical-stretch: 1;
                    for row in root.iplan-rows: Rectangle {
                        height: 30px;
                        background: row.selected ? Palette.hover : transparent;

                        TouchArea {
                            clicked => { root.iplan-select(row.row-index); }
                        }

                        Text {
                            x: 6px;
                            width: 64px;
                            text: row.short-id;
                            color: Palette.text-faint;
                            font-size: 11px;
                            font-family: Palette.mono-font;
                            vertical-alignment: center;
                        }

                        Text {
                            x: 74px;
                            width: parent.width - 420px;
                            text: row.subject + (row.action == 1 && !row.has-message ? "   （需填写新消息）" : "");
                            color: Palette.text;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        HorizontalLayout {
                            x: parent.width - 340px;
                            width: 336px;
                            spacing: 3px;

                            for action-label[action-index] in ["保留", "改写", "压缩", "吞并", "丢弃"]: TabButton {
                                width: 62px;
                                text: action-label;
                                active: row.action == action-index;
                                clicked => { root.iplan-action(row.row-index, action-index); }
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: Palette.line; }

                Text {
                    text: root.iplan-message-visible
                        ? "所选提交的新消息（「改写」需要填写）"
                        : "选中一行后可「改写」其消息；「压缩/吞并」会并入上一行提交";
                    color: Palette.text-dim;
                    font-size: 11px;
                }

                Rectangle {
                    height: root.iplan-message-visible ? 54px : 0px;
                    visible: root.iplan-message-visible;
                    background: Palette.bg;
                    border-color: Palette.border;
                    border-width: 1px;
                    border-radius: 3px;

                    TextInput {
                        x: 6px;
                        y: 4px;
                        width: parent.width - 12px;
                        height: parent.height - 8px;
                        text <=> root.iplan-message;
                        single-line: false;
                        wrap: word-wrap;
                        color: Palette.text;
                        font-size: 12px;
                        font-family: Palette.mono-font;
                        edited => { root.iplan-set-message(root.iplan-message); }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    FlatButton {
                        text: "取消";
                        clicked => { root.iplan-cancel(); }
                    }
                    FlatButton {
                        text: "开始变基";
                        danger: true;
                        clicked => { root.iplan-confirm(); }
                    }
                }
            }
        }
    }

    // ------------------------------------------------ 三路冲突编辑器（FR-CFL）
    Rectangle {
        visible: root.cfl-visible;
        background: #00000099;

        TouchArea {}

        Rectangle {
            width: min(parent.width - 40px, 1180px);
            height: min(parent.height - 40px, 720px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Palette.panel;
            border-color: Palette.border;
            border-width: 1px;
            border-radius: 6px;

            VerticalLayout {
                padding: 14px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 8px;

                    Text {
                        horizontal-stretch: 1;
                        text: root.cfl-title;
                        color: Palette.text;
                        font-size: 14px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.cfl-summary;
                        color: Palette.text-faint;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 6px;

                    FlatButton {
                        text: "全部取当前分支";
                        enabled: !root.read-only;
                        clicked => { root.cfl-resolve-all(0); }
                    }
                    FlatButton {
                        text: "全部取合入分支";
                        enabled: !root.read-only;
                        clicked => { root.cfl-resolve-all(1); }
                    }
                    FlatButton {
                        text: "全部取双方";
                        enabled: !root.read-only;
                        clicked => { root.cfl-resolve-all(2); }
                    }
                    FlatButton {
                        text: "整文件取当前分支";
                        enabled: !root.read-only;
                        clicked => { root.cfl-take-side(2); }
                    }
                    FlatButton {
                        text: "整文件取合入分支";
                        enabled: !root.read-only;
                        clicked => { root.cfl-take-side(3); }
                    }
                    FlatButton {
                        text: "标记为已解决";
                        enabled: !root.read-only;
                        clicked => { root.cfl-mark-resolved(); }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    FlatButton {
                        text: "关闭";
                        clicked => { root.cfl-close(); }
                    }
                }

                Rectangle { height: 1px; background: Palette.line; }

                HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: 0px;

                    ListView {
                        width: 250px;
                        for file-row in root.cfl-files: Rectangle {
                            height: 26px;
                            background: file-row.selected ? Palette.hover : transparent;

                            TouchArea {
                                clicked => { root.cfl-select(file-row.row-index); }
                            }

                            Text {
                                x: 6px;
                                width: 26px;
                                text: file-row.code;
                                color: Palette.amber;
                                font-size: 11px;
                                font-family: Palette.mono-font;
                                vertical-alignment: center;
                            }

                            Text {
                                x: 34px;
                                width: parent.width - 74px;
                                text: file-row.path;
                                color: Palette.text;
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            Text {
                                x: parent.width - 38px;
                                width: 32px;
                                text: file-row.hunks > 0 ? "×" + file-row.hunks : "✓";
                                color: file-row.hunks > 0 ? Palette.amber : Palette.green;
                                font-size: 11px;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                            }
                        }
                    }

                    Rectangle { width: 1px; background: Palette.line; }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 0px;

                        Flickable {
                            vertical-stretch: 1;
                            content-height: conflict-content.preferred-height;
                            content-width: self.width;

                            conflict-content := VerticalLayout {
                                width: parent.width;
                                spacing: 2px;

                                for row in root.cfl-rows: Rectangle {
                                    // 上下文行紧凑，冲突卡片按内容撑开。
                                    height: row.kind == 0
                                        ? max(18px, context-text.preferred-height)
                                        : card.preferred-height + 8px;
                                    background: row.kind == 0 ? transparent : Palette.bg;
                                    border-color: row.kind == 0 ? transparent : (row.decided ? Palette.line : Palette.amber);
                                    border-width: 1px;
                                    border-radius: 4px;

                                    context-text := Text {
                                        x: 8px;
                                        width: parent.width - 16px;
                                        visible: row.kind == 0;
                                        text: row.result;
                                        color: Palette.text-dim;
                                        font-size: 11px;
                                        font-family: Palette.mono-font;
                                        wrap: word-wrap;
                                    }

                                    card := VerticalLayout {
                                        x: 6px;
                                        y: 4px;
                                        width: parent.width - 12px;
                                        visible: row.kind == 1;
                                        spacing: 4px;

                                        HorizontalLayout {
                                            spacing: 6px;

                                            Text {
                                                horizontal-stretch: 1;
                                                text: row.label;
                                                color: row.decided ? Palette.green : Palette.amber;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                            }

                                            FlatButton {
                                                text: "取当前分支";
                                                enabled: !root.read-only;
                                                clicked => { root.cfl-resolve(row.block, 0); }
                                            }
                                            FlatButton {
                                                text: "取合入分支";
                                                enabled: !root.read-only;
                                                clicked => { root.cfl-resolve(row.block, 1); }
                                            }
                                            FlatButton {
                                                text: "取双方";
                                                enabled: !root.read-only;
                                                clicked => { root.cfl-resolve(row.block, 2); }
                                            }
                                            FlatButton {
                                                text: "取共同祖先";
                                                enabled: !root.read-only;
                                                clicked => { root.cfl-resolve(row.block, 3); }
                                            }
                                            FlatButton {
                                                text: "手动编辑";
                                                enabled: !root.read-only;
                                                clicked => { root.cfl-pick-block(row.block); }
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 6px;

                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                spacing: 1px;
                                                Text {
                                                    text: "当前分支";
                                                    color: Palette.text-faint;
                                                    font-size: 10px;
                                                }
                                                Text {
                                                    text: row.ours == "" ? "（空）" : row.ours;
                                                    color: Palette.text;
                                                    font-size: 11px;
                                                    font-family: Palette.mono-font;
                                                    wrap: word-wrap;
                                                }
                                            }

                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                spacing: 1px;
                                                Text {
                                                    text: "结果";
                                                    color: Palette.green;
                                                    font-size: 10px;
                                                }
                                                Text {
                                                    text: row.result;
                                                    color: Palette.text;
                                                    font-size: 11px;
                                                    font-family: Palette.mono-font;
                                                    wrap: word-wrap;
                                                }
                                            }

                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                spacing: 1px;
                                                Text {
                                                    text: "合入分支";
                                                    color: Palette.text-faint;
                                                    font-size: 10px;
                                                }
                                                Text {
                                                    text: row.theirs == "" ? "（空）" : row.theirs;
                                                    color: Palette.text;
                                                    font-size: 11px;
                                                    font-family: Palette.mono-font;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: root.cfl-manual-visible ? 96px : 0px;
                            visible: root.cfl-manual-visible;
                            background: Palette.bg;
                            border-color: Palette.border;
                            border-width: 1px;

                            TextInput {
                                x: 6px;
                                y: 4px;
                                width: parent.width - 120px;
                                height: parent.height - 8px;
                                text <=> root.cfl-manual;
                                single-line: false;
                                wrap: word-wrap;
                                color: Palette.text;
                                font-size: 11px;
                                font-family: Palette.mono-font;
                                edited => { root.cfl-set-manual(root.cfl-manual); }
                            }

                            FlatButton {
                                x: parent.width - 106px;
                                y: 6px;
                                text: "应用到该块";
                                enabled: !root.read-only && root.cfl-block >= 0;
                                clicked => { root.cfl-apply-manual(); }
                            }
                        }
                    }
                }
            }
        }
    }

    // ------------------------------------------------ 比较 / 快照浏览（FR-LOG-08）
    Rectangle {
        visible: root.compare-visible;
        background: #00000099;

        TouchArea {}

        Rectangle {
            width: min(parent.width - 120px, 760px);
            height: min(parent.height - 120px, 520px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Palette.panel;
            border-color: Palette.border;
            border-width: 1px;
            border-radius: 6px;

            VerticalLayout {
                padding: 14px;
                spacing: 8px;

                Text {
                    text: root.compare-title;
                    color: Palette.text;
                    font-size: 14px;
                    font-weight: 600;
                    wrap: word-wrap;
                }

                Text {
                    text: root.compare-browse
                        ? "只读浏览：此视图不修改工作区，双击文件可在下方查看差异"
                        : "两提交比较：双击文件可在下方查看差异";
                    color: root.compare-browse ? Palette.amber : Palette.text-faint;
                    font-size: 11px;
                }

                Rectangle { height: 1px; background: Palette.line; }

                ListView {
                    vertical-stretch: 1;
                    for row[index] in root.compare-rows: Rectangle {
                        height: 24px;
                        background: row.selected ? Palette.hover : transparent;

                        TouchArea {
                            clicked => { root.compare-select(index); }
                        }

                        Text {
                            x: 6px;
                            width: 24px;
                            text: row.code;
                            color: Palette.amber;
                            font-size: 11px;
                            font-family: Palette.mono-font;
                            vertical-alignment: center;
                        }

                        Text {
                            x: 34px;
                            width: parent.width - 120px;
                            text: row.path;
                            color: Palette.text;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        Text {
                            x: parent.width - 80px;
                            width: 74px;
                            text: row.status;
                            color: Palette.text-faint;
                            font-size: 11px;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                        }
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    FlatButton {
                        text: "关闭";
                        clicked => { root.compare-close(); }
                    }
                }
            }
        }
    }

}
