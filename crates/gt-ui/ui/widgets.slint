// Knotwork 基础组件库（M4.5 S2，IDEA New UI 复刻）。
//
// 形态约定：
//   - 工具栏 / 行内按钮一律 ghost（透明底、hover 才起底色、无边框）；
//   - 提交 / 对话框动作按钮 outline、primary；
//   - 工具条图标 16px，点击热区 26px；
//   - 列表选中色、日志当前分支底色取自 Palette。
//
// 兼容约定：每个历史控件保留同名子类（FlatButton / TabButton / Field /
// OptionToggle / CtxMenuItem），旧调用点零改动即可获得新观感。

import { Palette, Metrics } from "theme.slint";
import { IdeaIcon } from "icons.slint";


export component IdeaButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> danger: false;
    // ghost | outline | primary
    in property <string> variant: "ghost";
    callback clicked();

    height: 28px;
    width: max(64px, label.preferred-width + 24px);
    border-radius: Palette.radius;
    border-width: root.variant == "outline" ? 1px : 0px;
    border-color: root.danger ? Palette.red : Palette.border;
    background: !root.enabled
        ? (root.variant == "ghost" ? transparent : Palette.btn-disabled)
        : (touch.pressed
            ? Palette.btn-pressed
            : (touch.has-hover
                ? (root.danger && root.variant == "ghost" ? Palette.danger-bg : Palette.btn-hover)
                : (root.variant == "outline"
                    ? Palette.panel
                    : (root.variant == "primary" ? Palette.accent-strong : transparent))));

    label := Text {
        text: root.text;
        color: !root.enabled
            ? Palette.text-faint
            : (root.variant == "primary"
                ? Palette.on-accent
                : (root.danger ? Palette.red : Palette.text));
        font-size: Palette.font-md;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component FlatButton inherits IdeaButton { }


export component IdeaIconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> enabled: true;
    in property <bool> active: false;
    in property <color> tint: Palette.icon;
    callback clicked();

    width: Metrics.icon-button;
    height: Metrics.icon-button;
    border-radius: Palette.radius-sm;
    background: !root.enabled
        ? transparent
        : (touch.pressed
            ? Palette.action-pressed
            : (touch.has-hover || root.active ? Palette.action-hover : transparent));

    IdeaIcon {
        icon-size: Metrics.icon-size;
        tint: !root.enabled
            ? Palette.text-faint
            : (touch.has-hover ? Palette.icon-hover : root.tint);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: root.icon;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}


export component ToolbarSeparator inherits Rectangle {
    width: 1px;
    height: 16px;
    background: Palette.line;
}


export component IdeaTab inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();

    height: Metrics.tab-height;
    width: max(72px, label.preferred-width + 28px);
    background: touch.has-hover && !root.active ? Palette.action-hover : transparent;

    label := Text {
        text: root.text;
        color: root.active ? Palette.text : Palette.text-faint;
        font-size: Palette.font-md;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Rectangle {
        width: root.width;
        height: 2px;
        y: root.height - self.height;
        background: Palette.accent-strong;
        visible: root.active;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component TabButton inherits IdeaTab { }


export component IdeaInput inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "";
    in property <bool> monospace: false;
    callback edited(string);

    height: 28px;
    background: Palette.field-bg;
    border-radius: Palette.radius;
    border-width: 1px;
    border-color: input.has-focus ? Palette.accent-strong : Palette.field-border;

    input := TextInput {
        x: 8px;
        width: parent.width - 16px;
        height: parent.height;
        text <=> root.text;
        single-line: true;
        color: Palette.text;
        font-size: Palette.font-md;
        font-family: root.monospace ? Palette.mono-font : "";
        vertical-alignment: center;
        edited => { root.edited(root.text); }
    }

    Text {
        x: 8px;
        width: parent.width - 16px;
        text: root.placeholder;
        color: Palette.text-faint;
        font-size: Palette.font-md;
        font-family: root.monospace ? Palette.mono-font : "";
        vertical-alignment: center;
        overflow: elide;
        visible: root.text == "";
    }
}

export component Field inherits IdeaInput { }


export component IdeaSearchField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "";
    in property <bool> regex;
    callback edited(string);
    callback regex-toggled();
    callback accepted();

    height: 28px;
    width: 260px;
    background: Palette.field-bg;
    border-radius: Palette.radius;
    border-width: 1px;
    border-color: input.has-focus ? Palette.accent-strong : Palette.field-border;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 4px;
        spacing: 6px;
        alignment: center;

        IdeaIcon {
            name: "search";
            tint: Palette.text-faint;
            icon-size: 14px;
        }

        input := TextInput {
            horizontal-stretch: 1;
            text <=> root.text;
            single-line: true;
            color: Palette.text;
            font-size: Palette.font-md;
            vertical-alignment: center;
            edited => { root.edited(root.text); }
            accepted => { root.accepted(); }
        }

        Rectangle {
            width: max(22px, regex-label.preferred-width + 8px);
            height: 20px;
            border-radius: Palette.radius-xs;
            background: regex-touch.has-hover ? Palette.action-hover : transparent;

            regex-label := Text {
                text: ".*";
                color: root.regex ? Palette.accent-strong : Palette.text-faint;
                font-size: Palette.font-sm;
                font-family: Palette.mono-font;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            regex-touch := TouchArea {
                clicked => { root.regex-toggled(); }
            }
        }
    }

    Text {
        x: 28px;
        width: parent.width - 62px;
        height: 100%;
        text: root.placeholder;
        color: Palette.text-faint;
        font-size: Palette.font-md;
        vertical-alignment: center;
        overflow: elide;
        visible: root.text == "";
    }
}


export component IdeaChip inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    callback toggled();

    width: max(56px, label.preferred-width + 18px);
    height: 24px;
    border-radius: Palette.radius-sm;
    background: root.checked ? Palette.accent : (touch.has-hover ? Palette.hover : transparent);
    border-width: 1px;
    border-color: root.checked ? Palette.accent-strong : Palette.line;

    label := Text {
        text: (root.checked ? "✓ " : "") + root.text;
        color: root.checked ? Palette.accent-text : Palette.text-faint;
        font-size: Palette.font-sm;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.toggled(); }
    }
}

export component OptionToggle inherits IdeaChip { }


export component IdeaCheckbox inherits Rectangle {
    in property <string> text;
    in property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled();

    height: 24px;
    width: max(72px, check-label.preferred-width + 24px);
    background: transparent;

    HorizontalLayout {
        spacing: 5px;
        alignment: center;

        Rectangle {
            width: 14px;
            height: 14px;
            border-radius: Palette.radius-xs;
            border-width: 1px;
            border-color: !root.enabled
                ? Palette.text-faint
                : (root.checked ? Palette.accent-strong : Palette.field-border);
            background: root.checked ? Palette.accent-strong : Palette.field-bg;

            Text {
                text: "✓";
                color: Palette.on-accent;
                font-size: 10px;
                horizontal-alignment: center;
                vertical-alignment: center;
                visible: root.checked;
            }
        }

        check-label := Text {
            text: root.text;
            color: root.enabled ? Palette.text-dim : Palette.text-faint;
            font-size: Palette.font-sm;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.toggled(); }
    }
}


export component FilterButton inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    callback clicked();

    height: 24px;
    width: max(56px, label.preferred-width + 22px);
    border-radius: Palette.radius-sm;
    background: touch.has-hover || root.active ? Palette.action-hover : transparent;

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 4px;
        alignment: center;

        label := Text {
            text: root.text;
            color: root.active ? Palette.text : Palette.text-dim;
            font-size: Palette.font-sm;
            vertical-alignment: center;
        }

        IdeaIcon {
            name: "chevron-down";
            icon-size: 12px;
            tint: Palette.text-faint;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}


export component IdeaRefBadge inherits Rectangle {
    in property <string> text;
    // 0 = HEAD/当前分支，1 = 本地分支，2 = 远程分支，3 = 标签
    in property <int> kind: 1;

    height: 20px;
    width: max(44px, badge-text.preferred-width + 24px);
    border-radius: Palette.radius-sm;
    border-width: 1px;
    border-color: Palette.badge-border;
    background: Palette.badge-bg;

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 6px;
        spacing: 3px;
        alignment: center;

        IdeaIcon {
            name: root.kind == 3 ? "tag" : "branch";
            icon-size: 12px;
            tint: root.kind == 0
                ? Palette.ref-head
                : (root.kind == 2 ? Palette.ref-remote : (root.kind == 3 ? Palette.ref-tag : Palette.ref-local));
        }

        badge-text := Text {
            text: root.text;
            color: Palette.log-ref-fg;
            font-size: Palette.font-meta;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}


export component MenuItem inherits Rectangle {
    in property <string> text;
    in property <string> shortcut: "";
    in property <bool> enabled: true;
    in property <bool> danger: false;
    callback clicked();

    height: 28px;
    border-radius: Palette.radius-sm;
    background: touch.has-hover && root.enabled ? Palette.hover : transparent;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 16px;

        Text {
            horizontal-stretch: 1;
            text: root.text;
            color: !root.enabled ? Palette.text-faint : (root.danger ? Palette.red : Palette.text);
            font-size: Palette.font-md;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            text: root.shortcut;
            color: Palette.text-faint;
            font-size: Palette.font-sm;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component CtxMenuItem inherits MenuItem { }


export component Divider inherits Rectangle {
    height: 1px;
    background: Palette.line;
}

export component VDivider inherits Rectangle {
    width: 1px;
    background: Palette.line;
}

export component SectionLabel inherits Text {
    color: Palette.text-dim;
    font-size: Palette.font-md;
    font-weight: 600;
    vertical-alignment: center;
}


export component ToolWindowHeader inherits Rectangle {
    in property <string> title;
    in property <bool> show-more: true;
    in property <bool> show-minimize: true;
    callback toggle-more();
    callback toggle-minimize();

    height: Metrics.toolwindow-header-height;
    background: Palette.toolwindow-header;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 4px;
        spacing: 2px;

        Text {
            horizontal-stretch: 1;
            text: root.title;
            color: Palette.text;
            font-size: Palette.font-md;
            font-weight: 600;
            vertical-alignment: center;
        }

        IdeaIconButton {
            icon: "more";
            visible: root.show-more;
            clicked => { root.toggle-more(); }
        }

        IdeaIconButton {
            icon: "remove";
            visible: root.show-minimize;
            clicked => { root.toggle-minimize(); }
        }
    }

    Rectangle {
        width: parent.width;
        height: 1px;
        y: parent.height - self.height;
        background: Palette.toolwindow-border;
    }
}


export component DialogShell inherits Rectangle {
    in property <string> title;
    in property <bool> danger: false;
    in property <length> dialog-max-width: 520px;
    in property <length> dialog-max-height: 320px;

    background: Palette.scrim;

    TouchArea { }

    Rectangle {
        width: min(parent.width - 80px, root.dialog-max-width);
        height: min(parent.height - 80px, root.dialog-max-height);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Palette.panel;
        border-color: root.danger ? Palette.red : Palette.border;
        border-width: 1px;
        border-radius: Palette.radius-lg;

        VerticalLayout {
            padding: 18px;
            spacing: 10px;

            Text {
                text: root.title;
                color: root.danger ? Palette.red : Palette.text;
                font-size: Palette.font-title;
                font-weight: 600;
                wrap: word-wrap;
            }

            Divider { }

            @children
        }
    }
}
